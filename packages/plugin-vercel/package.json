{
  "name": "@jini-ai/plugin-vercel",
  "version": "0.6.17",
  "description": "Independently installable Vercel static-site publishing and Vercel Blob share links in the portable Agent Plugins format.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugin-vercel"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./package.json": "universal",
      "./plugin.json": "universal",
      "./vercel/*": "universal"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./plugin.json": "./vercel/plugin.json",
    "./vercel/*": "./vercel/*"
  },
  "files": ["vercel", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts vercel",
    "prepack": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts vercel"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
