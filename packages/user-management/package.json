      "./react/auth/owner-passkey-api": "browser",
      "./react/auth/owner-recovery-api": "browser",
      "./react/auth/local-owner-signin": "browser"
    },
    "isolation": {
      "entries": {
        "./identity/boot-session-token": "server",
        "./identity/builtin-role-grants": "server",
        "./identity/permission-grants": "server",
        "./identity/role-manage-permission": "server",
        "./identity/user-manage-permission": "server",
        "./identity/api-key-types": "server",
        "./identity/api-key-secret": "server",
        "./identity/api-key-service": "server",
        "./identity/owner-reset-env": "server",
        "./identity/repo.memory": "server",
        "./identity/user-purge-types": "server",
        "./identity/username-change-ports": "server",
        "./identity/delete-user-service": "server"
      }
    },
    "optionalPeers": {
      "argon2": "opt-in: argon2 password hashing; import @jini-ai/user-management/server — Argon2 password hashing could not load argon2. Install argon2 to enable this feature, or check its installed version and native binaries.",
      "@jini-ai/ui-kit": "opt-in: ui kit integrations; import @jini-ai/user-management/react — UI kit integrations could not load @jini-ai/ui-kit. Install @jini-ai/ui-kit to enable this feature, or check its installed version and native binaries.",
