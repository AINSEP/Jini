{
  "name": "@jini-ai/plugin-github",
  "version": "0.6.17",
  "description": "Independently installable GitHub Agent Plugin (repository files, site backup, source control, deployments and Actions deploy ops) in the portable Agent Plugins format.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugin-github"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./package.json": "universal",
      "./plugin.json": "universal",
      "./github/*": "universal"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./plugin.json": "./github/plugin.json",
    "./github/*": "./github/*"
  },
  "files": ["github", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts github",
    "prepack": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts github"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
