{
  "name": "@jini-ai/mcp",
  "version": "0.7.3-next.2",
  "description": "Model Context Protocol adapters: server config schema and IO, an MCP client, and agent-side MCP server installation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/mcp"
  },
  "jini": {
    "domain": "integration",
    "kind": "protocol-adapter",
    "runtime": "node",
    "entries": {
      ".": "node",
      "./bin": "node",
      "./tools/ask-choice": "universal",
      "./federation": "node",
      "./federation/approvals": "node",
      "./federation/stdio": "node",
      "./federation/testing": "universal",
      "./federation/hosted": "node",
      "./external/built-in-connections": "universal",
      "./external/agent-tools": "universal",
      "./external/operations-tools": "universal",
      "./federation/external-mcp-admissions": "universal",
      "./external/external-mcp-host-copy": "universal"
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tools/ask-choice": {
      "types": "./dist/tools/ask-choice/index.d.ts",
      "import": "./dist/tools/ask-choice/index.js",
      "default": "./dist/tools/ask-choice/index.js"
    },
    "./federation": {
      "types": "./dist/federation/index.d.ts",
      "import": "./dist/federation/index.js",
      "default": "./dist/federation/index.js"
    },
    "./federation/approvals": {
      "types": "./dist/federation/approvals/index.d.ts",
      "import": "./dist/federation/approvals/index.js",
      "default": "./dist/federation/approvals/index.js"
    },
    "./federation/stdio": {
      "types": "./dist/federation/stdio/index.d.ts",
      "import": "./dist/federation/stdio/index.js",
      "default": "./dist/federation/stdio/index.js"
    },
    "./federation/testing": {
      "types": "./dist/federation/testing/index.d.ts",
      "import": "./dist/federation/testing/index.js",
      "default": "./dist/federation/testing/index.js"
    },
    "./federation/hosted": {
      "types": "./dist/federation/hosted/index.d.ts",
      "import": "./dist/federation/hosted/index.js",
      "default": "./dist/federation/hosted/index.js"
    },
    "./bin": {
      "types": "./dist/bin/serve.d.ts",
      "import": "./dist/bin/serve.js",
      "default": "./dist/bin/serve.js"
    },
    "./external/built-in-connections": {
      "types": "./dist/external/built-in-connections.d.ts",
      "import": "./dist/external/built-in-connections.js",
      "default": "./dist/external/built-in-connections.js"
    },
    "./external/agent-tools": {
      "types": "./dist/external/agent-tools.d.ts",
      "import": "./dist/external/agent-tools.js",
      "default": "./dist/external/agent-tools.js"
    },
    "./external/operations-tools": {
      "types": "./dist/external/operations-tools.d.ts",
      "import": "./dist/external/operations-tools.js",
      "default": "./dist/external/operations-tools.js"
    },
    "./federation/external-mcp-admissions": {
      "types": "./dist/federation/external-mcp-admissions.d.ts",
      "import": "./dist/federation/external-mcp-admissions.js",
      "default": "./dist/federation/external-mcp-admissions.js"
    },
    "./external/external-mcp-host-copy": {
      "types": "./dist/external/external-mcp-host-copy.d.ts",
      "import": "./dist/external/external-mcp-host-copy.js",
      "default": "./dist/external/external-mcp-host-copy.js"
    }
  },
  "bin": {
    "jini-mcp": "./dist/bin/serve.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^",
    "@jini-ai/protocol": "workspace:^",
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@jini-ai/core": "workspace:^",
    "@jini-ai/daemon": "workspace:^",
    "@jini-ai/platform": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
