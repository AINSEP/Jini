{
  "name": "@jini-ai/mcp",
  "version": "0.7.3-next.2",
  "description": "Model Context Protocol adapters: server config schema and IO, an MCP client, and agent-side MCP server installation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/mcp"
  },
  "jini": {
    "domain": "integration",
    "kind": "protocol-adapter",
    "runtime": "node",
    "entries": {
      ".": "node",
      "./bin": "node",
      "./tools/ask-choice": "universal",
      "./federation": "node",
      "./federation/approvals": "node",
      "./federation/stdio": "node",
      "./federation/testing": "universal",
      "./federation/hosted": "node",
      "./external/built-in-connections": "universal",
      "./external/agent-tools": "universal",
      "./external/operations-tools": "universal",
      "./federation/external-mcp-admissions": "universal",
      "./external/external-mcp-host-copy": "universal",
      "./external/save-form": "universal",
      "./federation/external-mcp-probe": "node",
      "./federation/hosted/external-mcp-repo": "node",
      "./react/external-mcp/ExternalMcpAdmissionsBanner": "browser",
      "./react/external-mcp/ExternalMcpSettingsPanel.hooks": "browser",
      "./react/external-mcp/hooks/use-external-mcp-admissions.hooks": "browser",
      "./external/tool-registrations": "node"
    },
    "optionalPeers": {
      "kysely": "opt-in: hosted MCP SQL — Install kysely to use the hosted MCP SQL repository.",
      "react": "opt-in: react browser bindings; import @jini-ai/mcp/react/external-mcp/ExternalMcpAdmissionsBanner — React browser bindings could not load react. Install react to enable this feature, or check its installed version."
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tools/ask-choice": {
      "types": "./dist/tools/ask-choice/index.d.ts",
      "import": "./dist/tools/ask-choice/index.js",
      "default": "./dist/tools/ask-choice/index.js"
    },
    "./federation": {
      "types": "./dist/federation/index.d.ts",
      "import": "./dist/federation/index.js",
      "default": "./dist/federation/index.js"
    },
    "./federation/approvals": {
      "types": "./dist/federation/approvals/index.d.ts",
      "import": "./dist/federation/approvals/index.js",
      "default": "./dist/federation/approvals/index.js"
    },
    "./federation/stdio": {
      "types": "./dist/federation/stdio/index.d.ts",
      "import": "./dist/federation/stdio/index.js",
      "default": "./dist/federation/stdio/index.js"
    },
    "./federation/testing": {
      "types": "./dist/federation/testing/index.d.ts",
      "import": "./dist/federation/testing/index.js",
      "default": "./dist/federation/testing/index.js"
    },
    "./federation/hosted": {
      "types": "./dist/federation/hosted/index.d.ts",
      "import": "./dist/federation/hosted/index.js",
      "default": "./dist/federation/hosted/index.js"
    },
    "./bin": {
      "types": "./dist/bin/serve.d.ts",
      "import": "./dist/bin/serve.js",
      "default": "./dist/bin/serve.js"
    },
    "./external/built-in-connections": {
      "types": "./dist/external/built-in-connections.d.ts",
      "import": "./dist/external/built-in-connections.js",
      "default": "./dist/external/built-in-connections.js"
    },
    "./external/agent-tools": {
      "types": "./dist/external/agent-tools.d.ts",
      "import": "./dist/external/agent-tools.js",
      "default": "./dist/external/agent-tools.js"
    },
    "./external/operations-tools": {
      "types": "./dist/external/operations-tools.d.ts",
      "import": "./dist/external/operations-tools.js",
      "default": "./dist/external/operations-tools.js"
    },
    "./federation/external-mcp-admissions": {
      "types": "./dist/federation/external-mcp-admissions.d.ts",
      "import": "./dist/federation/external-mcp-admissions.js",
      "default": "./dist/federation/external-mcp-admissions.js"
    },
    "./external/external-mcp-host-copy": {
      "types": "./dist/external/external-mcp-host-copy.d.ts",
      "import": "./dist/external/external-mcp-host-copy.js",
      "default": "./dist/external/external-mcp-host-copy.js"
    },
    "./external/save-form": {
      "types": "./dist/external/save-form.d.ts",
      "import": "./dist/external/save-form.js",
      "default": "./dist/external/save-form.js"
    },
    "./federation/external-mcp-probe": {
      "types": "./dist/federation/external-mcp-probe.d.ts",
      "import": "./dist/federation/external-mcp-probe.js",
      "default": "./dist/federation/external-mcp-probe.js"
    },
    "./federation/hosted/external-mcp-repo": {
      "types": "./dist/federation/hosted/external-mcp-repo.d.ts",
      "import": "./dist/federation/hosted/external-mcp-repo.js",
      "default": "./dist/federation/hosted/external-mcp-repo.js"
    },
    "./react/external-mcp/ExternalMcpAdmissionsBanner": {
      "types": "./dist/react/external-mcp/ExternalMcpAdmissionsBanner.d.ts",
      "import": "./dist/react/external-mcp/ExternalMcpAdmissionsBanner.js",
      "default": "./dist/react/external-mcp/ExternalMcpAdmissionsBanner.js"
    },
    "./react/external-mcp/ExternalMcpSettingsPanel.hooks": {
      "types": "./dist/react/external-mcp/ExternalMcpSettingsPanel.hooks.d.ts",
      "import": "./dist/react/external-mcp/ExternalMcpSettingsPanel.hooks.js",
      "default": "./dist/react/external-mcp/ExternalMcpSettingsPanel.hooks.js"
    },
    "./react/external-mcp/hooks/use-external-mcp-admissions.hooks": {
      "types": "./dist/react/external-mcp/hooks/use-external-mcp-admissions.hooks.d.ts",
      "import": "./dist/react/external-mcp/hooks/use-external-mcp-admissions.hooks.js",
      "default": "./dist/react/external-mcp/hooks/use-external-mcp-admissions.hooks.js"
    },
    "./external/tool-registrations": {
      "types": "./dist/external/tool-registrations.d.ts",
      "import": "./dist/external/tool-registrations.js",
      "default": "./dist/external/tool-registrations.js"
    }
  },
  "bin": {
    "jini-mcp": "./dist/bin/serve.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^",
    "@jini-ai/protocol": "workspace:^",
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@jini-ai/core": "workspace:^",
    "@jini-ai/daemon": "workspace:^",
    "@jini-ai/platform": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "kysely": "^0.29.6",
    "react": "^19.2.0",
    "@types/react": "^19.2.0",
    "@testing-library/react": "^16.3.0",
    "react-dom": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0"
  },
  "peerDependencies": {
    "kysely": "^0.29.6",
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
