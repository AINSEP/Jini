{
  "name": "@jini-ai/mcp",
  "version": "0.4.0",
  "description": "Model Context Protocol adapters: server config schema and IO, an MCP client, and agent-side MCP server installation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/mcp"
  },
  "jini": {
    "domain": "integration",
    "kind": "protocol-adapter",
    "runtime": "node",
    "entries": {
      ".": "node",
      "./bin": "node",
      "./tools/ask-choice": "universal",
      "./federation": "node",
      "./federation/approvals": "node",
      "./federation/stdio": "node",
      "./federation/testing": "universal"
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tools/ask-choice": {
      "types": "./dist/tools/ask-choice/index.d.ts",
      "import": "./dist/tools/ask-choice/index.js",
      "default": "./dist/tools/ask-choice/index.js"
    },
    "./federation": {
      "types": "./dist/federation/index.d.ts",
      "import": "./dist/federation/index.js",
      "default": "./dist/federation/index.js"
    },
    "./federation/approvals": {
      "types": "./dist/federation/approvals/index.d.ts",
      "import": "./dist/federation/approvals/index.js",
      "default": "./dist/federation/approvals/index.js"
    },
    "./federation/stdio": {
      "types": "./dist/federation/stdio/index.d.ts",
      "import": "./dist/federation/stdio/index.js",
      "default": "./dist/federation/stdio/index.js"
    },
    "./federation/testing": {
      "types": "./dist/federation/testing/index.d.ts",
      "import": "./dist/federation/testing/index.js",
      "default": "./dist/federation/testing/index.js"
    },
    "./bin": {
      "types": "./dist/bin/serve.d.ts",
      "import": "./dist/bin/serve.js",
      "default": "./dist/bin/serve.js"
    }
  },
  "bin": {
    "jini-mcp": "./dist/bin/serve.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@jini-ai/core": "workspace:*",
    "@jini-ai/platform": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
