{
  "name": "@jini-ai/plugin-resend",
  "version": "0.6.17",
  "description": "Independently installable Resend mail Agent Plugin (mail adapter, domain setup and delivery feedback) in the portable Agent Plugins format.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugin-resend"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./package.json": "universal",
      "./plugin.json": "universal",
      "./resend/*": "universal"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./plugin.json": "./resend/plugin.json",
    "./resend/*": "./resend/*"
  },
  "files": ["resend", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts resend",
    "prepack": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts resend"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
