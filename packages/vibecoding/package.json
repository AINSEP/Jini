{
  "name": "@jini-ai/vibecoding",
  "version": "0.1.0",
  "description": "Conversational artifact authoring: a target-agnostic edit loop — addressable parts, validated replace, and per-turn snapshot/rewind. Framework-free in `/core`; filesystem targets behind ./node and the chat/preview surface behind ./react.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/vibecoding"
  },
  "jini": {
    "domain": "capability",
    "kind": "authoring",
    "runtime": "universal",
    "entries": {
      ".": "universal",
      "./core": "universal"
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
