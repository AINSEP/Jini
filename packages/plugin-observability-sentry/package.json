{
  "name": "@jini-ai/plugin-observability-sentry",
  "version": "0.6.15",
  "description": "Standalone Sentry server observability provider artifact.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugin-observability-sentry"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "node",
    "entries": {
      "./package.json": "node",
      "./plugins/*": "node"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./plugins/*": "./plugins/*"
  },
  "files": [
    "plugins/observability-sentry",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node --import tsx ../provider-plugins/scripts/build.ts observability-sentry .",
    "prepack": "node --import tsx ../provider-plugins/scripts/build.ts observability-sentry .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@jini-ai/diagnostics": "workspace:^",
    "@jini-ai/plugins": "workspace:^",
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
