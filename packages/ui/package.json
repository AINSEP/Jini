{
  "name": "@jini-ai/ui",
  "version": "0.1.2",
  "description": "Generic, product-neutral React UI primitives and feature domains. The Excalidraw and Lexical editors live behind ./sketch-editor and ./lexical-rich-text-editor.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/ui"
  },
  "jini": {
    "domain": "ui",
    "kind": "react-library",
    "runtime": "browser"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sketch-editor": {
      "types": "./dist/features/sketch-editor/index.d.ts",
      "import": "./dist/features/sketch-editor/index.js",
      "default": "./dist/features/sketch-editor/index.js"
    },
    "./lexical-rich-text-editor": {
      "types": "./dist/features/lexical-rich-text-editor/index.d.ts",
      "import": "./dist/features/lexical-rich-text-editor/index.js",
      "default": "./dist/features/lexical-rich-text-editor/index.js"
    },
    "./chat": {
      "types": "./dist/react/chat/index.d.ts",
      "import": "./dist/react/chat/index.js",
      "default": "./dist/react/chat/index.js"
    },
    "./mcp-ui": {
      "types": "./dist/react/mcp-ui/index.d.ts",
      "import": "./dist/react/mcp-ui/index.js",
      "default": "./dist/react/mcp-ui/index.js"
    },
    "./mcp-ui/surfaces": {
      "types": "./dist/features/mcp-ui/index.d.ts",
      "import": "./dist/features/mcp-ui/index.js",
      "default": "./dist/features/mcp-ui/index.js"
    },
    "./settings-dialog.css": "./dist/features/settings/dialog/styles/settings-dialog.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/react/components/remixicon-font dist/features/settings/dialog/styles && cp src/react/components/remixicon-font/remixicon.css src/react/components/remixicon-font/remixicon.woff2 dist/react/components/remixicon-font/ && cp src/features/settings/dialog/styles/settings-dialog.css dist/features/settings/dialog/styles/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini-ai/agentic": "workspace:*",
    "@jini-ai/chat-core": "workspace:*",
    "@jini-ai/protocol": "workspace:*",
    "@jini-ai/renderers-react": "workspace:*",
    "@jini-ai/ui-core": "workspace:*",
    "micromark": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@lexical/react": "0.36.2",
    "@lexical/utils": "0.36.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "lexical": "0.36.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@lexical/react": "0.36.2",
    "@lexical/utils": "0.36.2",
    "lexical": "0.36.2",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@excalidraw/excalidraw": {
      "optional": true
    },
    "@lexical/react": {
      "optional": true
    },
    "@lexical/utils": {
      "optional": true
    },
    "lexical": {
      "optional": true
    }
  }
}
