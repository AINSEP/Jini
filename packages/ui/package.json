{
  "name": "@jini-ai/ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/ui"
  },
  "jini": {
    "domain": "ui",
    "kind": "react-library",
    "runtime": "browser",
    "admission": "locked"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@jini-ai/agentic": "workspace:*",
    "@jini-ai/renderers-react": "workspace:*",
    "@lexical/react": "0.36.2",
    "@lexical/utils": "0.36.2",
    "lexical": "0.36.2",
    "micromark": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1"
  }
}
