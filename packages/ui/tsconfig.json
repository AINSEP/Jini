{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["@testing-library/jest-dom"]
  },
  "include": ["src"],
  "exclude": [
    // The endpoint-policy parity test deliberately imports `agent-runtime`'s
    // `connection-guard.ts` by relative path, which lies outside this package's
    // `rootDir` and so cannot be part of this build. Vitest still runs it, and
    // reaching the other side's SOURCE is the whole point: importing the built
    // package instead would let the test pass against a stale `dist`, which is
    // useless in a check whose only job is to notice drift. Excluded here
    // rather than relaxing `rootDir`, which would change what this package
    // emits, or adding a dependency edge from a Node package to a UI one.
    // (Carried over unchanged from `@jini-ai/ui-core`'s own tsconfig.json,
    // 2026-08-01, when that package folded into this one.)
    "src/__tests__/utils/endpoint-policy.parity.test.ts"
  ]
}
