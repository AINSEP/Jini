{
  "name": "@jini-ai/sqlite",
  "version": "0.5.0",
  "description": "Deprecated compatibility exports for chat, daemon, registry and database concerns; server composition is imported directly from server.",
  "deprecated": "Compatibility shim: use @jini-ai/chat/store, @jini-ai/daemon/store, @jini-ai/registry/tool-catalog/sqlite and @jini-ai/db directly. See README.md for exact subpaths.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/sqlite"
  },
  "jini": {
    "domain": "server",
    "kind": "persistence-adapter",
    "runtime": "node"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini-ai/chat": "workspace:*",
    "@jini-ai/daemon": "workspace:*",
    "@jini-ai/db": "workspace:*",
    "@jini-ai/registry": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9"
  }
}
