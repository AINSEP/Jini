{
  "name": "@jini-ai/search",
  "version": "0.7.3-next.2",
  "description": "Generic site-search contract: provider interface, registry, single-writer indexer, query service with access revalidation, agent tools and a provider conformance test-kit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/search"
  },
  "jini": {
    "domain": "capability",
    "kind": "search",
    "runtime": "universal",
    "entries": {
      ".": "universal",
      "./tools": "universal",
      "./http-query": "universal",
      "./testkit": "universal",
      "./contribution": "node",
      "./site/settings": "universal",
      "./site/cms-document-source": "universal",
      "./site/access": "universal",
      "./site/index-state-store": "node",
      "./public-http/routes/site/search": "universal"
    },
    "optionalPeers": {
      "kysely": "opt-in: sql search-index store; import @jini-ai/search/site/index-state-store — The SQL search-index store could not load kysely. Install kysely to enable this feature, or check its installed version."
    },
    "isolation": {
      "entries": {
        "./public-http/routes/site/search": "http-query"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./http-query": {
      "types": "./dist/http-query.d.ts",
      "import": "./dist/http-query.js",
      "default": "./dist/http-query.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js",
      "default": "./dist/tools.js"
    },
    "./contribution": {
      "types": "./dist/contribution.d.ts",
      "import": "./dist/contribution.js",
      "default": "./dist/contribution.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "import": "./dist/testkit/index.js",
      "default": "./dist/testkit/index.js"
    },
    "./site/settings": {
      "types": "./dist/site/settings.d.ts",
      "import": "./dist/site/settings.js",
      "default": "./dist/site/settings.js"
    },
    "./site/cms-document-source": {
      "types": "./dist/site/cms-document-source.d.ts",
      "import": "./dist/site/cms-document-source.js",
      "default": "./dist/site/cms-document-source.js"
    },
    "./site/access": {
      "types": "./dist/site/access.d.ts",
      "import": "./dist/site/access.js",
      "default": "./dist/site/access.js"
    },
    "./site/index-state-store": {
      "types": "./dist/site/index-state-store.d.ts",
      "import": "./dist/site/index-state-store.js",
      "default": "./dist/site/index-state-store.js"
    },
    "./public-http/routes/site/search": {
      "types": "./dist/public-http/routes/site/search.d.ts",
      "import": "./dist/public-http/routes/site/search.js",
      "default": "./dist/public-http/routes/site/search.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2 --minWorkers=1",
    "test:coverage": "vitest run --maxWorkers=2 --minWorkers=1 --coverage"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "kysely": "^0.29.6"
  },
  "devDependencies": {
    "@jini-ai/agent-plugins": "workspace:*",
    "@vitest/coverage-v8": "^3.2.6",
    "vitest": "^3.2.6",
    "kysely": "^0.29.6",
    "@electric-sql/pglite": "0.5.8",
    "@jini-ai/db": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    }
  }
}
