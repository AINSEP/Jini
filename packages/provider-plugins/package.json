{
  "name": "@jini-ai/provider-plugins",
  "version": "0.6.24",
  "description": "Provider runtime artifacts, independently addressable as subpaths of @jini-ai/provider-plugins. Agent-facing plugins live in @jini-ai/agent-plugins.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/provider-plugins"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "node",
    "entries": {
      "./package.json": "node",
      "./catalog": "node",
      "./charts-echarts/*": "node",
      "./charts-recharts/*": "node",
      "./plugins/*": "node",
      "./ai-trace-langfuse": "node",
      "./ai-trace-langfuse/*": "node",
      "./analytics-posthog": "node",
      "./analytics-posthog/*": "node",
      "./observability-opentelemetry": "node",
      "./observability-opentelemetry/*": "node",
      "./observability-sentry": "node",
      "./observability-sentry/*": "node",
      "./payments-stripe": "node",
      "./payments-stripe/*": "node",
      "./fixture-provider/*": "node",
      "./formspree": "node",
      "./formspree/*": "node"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./catalog": "./catalog.json",
    "./charts-echarts/*": "./plugins/charts-echarts/*",
    "./charts-recharts/*": "./plugins/charts-recharts/*",
    "./plugins/*": "./plugins/*",
    "./ai-trace-langfuse": "./plugins/ai-trace-langfuse/0.6.24/jini.plugin.json",
    "./ai-trace-langfuse/*": "./plugins/ai-trace-langfuse/*",
    "./analytics-posthog": "./plugins/analytics-posthog/0.6.24/jini.plugin.json",
    "./analytics-posthog/*": "./plugins/analytics-posthog/*",
    "./observability-opentelemetry": "./plugins/observability-opentelemetry/0.6.24/jini.plugin.json",
    "./observability-opentelemetry/*": "./plugins/observability-opentelemetry/*",
    "./observability-sentry": "./plugins/observability-sentry/0.6.24/jini.plugin.json",
    "./observability-sentry/*": "./plugins/observability-sentry/*",
    "./payments-stripe": "./plugins/payments-stripe/0.6.24/jini.plugin.json",
    "./payments-stripe/*": "./plugins/payments-stripe/*",
    "./fixture-provider/*": "./plugins/fixture-provider/*",
    "./formspree": "./plugins/formspree/0.6.24/jini.plugin.json",
    "./formspree/*": "./plugins/formspree/*"
  },
  "files": [
    "plugins/ai-trace-langfuse",
    "plugins/analytics-posthog",
    "plugins/charts-echarts",
    "plugins/charts-recharts",
    "plugins/formspree",
    "plugins/fixture-provider",
    "plugins/observability-opentelemetry",
    "plugins/observability-sentry",
    "plugins/payments-stripe",
    "catalog.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "pnpm run typecheck && node --import tsx scripts/build.ts charts-recharts . && node --import tsx scripts/build.ts charts-echarts . && node --import tsx scripts/build.ts ai-trace-langfuse . && node --import tsx scripts/build.ts analytics-posthog . && node --import tsx scripts/build.ts observability-opentelemetry . && node --import tsx scripts/build.ts observability-sentry . && node --import tsx scripts/build.ts payments-stripe . && node --import tsx scripts/build.ts fixture-provider . && node --import tsx scripts/build.ts formspree .",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.charts.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run -c vitest.coverage.config.ts --coverage"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@jini-ai/agent-runtime": "workspace:^",
    "@jini-ai/analytics": "workspace:^",
    "@jini-ai/capability-providers": "workspace:^",
    "@jini-ai/commerce": "workspace:^",
    "@jini-ai/cookie-consent": "workspace:^",
    "@jini-ai/diagnostics": "workspace:^",
    "@jini-ai/plugins": "workspace:^",
    "@jini-ai/ui": "workspace:^",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/otlp-exporter-base": "^0.221.0",
    "@opentelemetry/otlp-transformer": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "11.6.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "21.1.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "echarts": "6.1.0",
    "esbuild": "^0.28.1",
    "jsdom": "25.0.1",
    "langfuse": "3.39.2",
    "posthog-js": "1.260.2",
    "posthog-node": "5.55.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "@jini-ai/cms": "workspace:^"
  }
}
