{
  "name": "@jini-ai/provider-plugins",
  "version": "0.6.13",
  "description": "Self-contained server provider plugin artifacts for the existing Jini plugin host.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/provider-plugins"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "node",
    "entries": {
      "./catalog": "node",
      "./plugins/*": "node"
    }
  },
  "exports": {
    "./catalog": "./catalog.json",
    "./plugins/*": "./plugins/*"
  },
  "files": [
    "catalog.json",
    "plugins",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run -c vitest.coverage.config.ts --coverage"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@jini-ai/agent-runtime": "workspace:^",
    "@jini-ai/analytics": "workspace:^",
    "@jini-ai/capability-providers": "workspace:^",
    "@jini-ai/commerce": "workspace:^",
    "@jini-ai/cookie-consent": "workspace:^",
    "@jini-ai/diagnostics": "workspace:^",
    "@jini-ai/plugins": "workspace:^",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/otlp-exporter-base": "^0.221.0",
    "@opentelemetry/otlp-transformer": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "11.6.0",
    "esbuild": "^0.28.1",
    "langfuse": "3.39.2",
    "posthog-js": "1.260.2",
    "posthog-node": "5.55.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
