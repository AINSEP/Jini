{
  "id": "observability-opentelemetry",
  "name": "OpenTelemetry",
  "version": "0.6.12",
  "sdkRange": "^0.1.0 || ^1.0.0",
  "engine": 1,
  "tier": "tier-3",
  "extensions": {
    "tovu": {
      "id": "jini/observability-opentelemetry"
    },
    "open-marketing": {
      "id": "jini/observability-opentelemetry"
    }
  },
  "capabilities": [
    "providers.register"
  ],
  "contributes": {
    "providers": [
      {
        "contract": "observability",
        "id": "opentelemetry",
        "contractVersion": 1,
        "settings": [
          {
            "name": "endpoint",
            "label": "OTLP endpoint",
            "required": true,
            "hint": "Any OTLP/HTTP endpoint, e.g. https://otlp-gateway-prod-us-east-0.grafana.net/otlp (traces go to /v1/traces; metrics to /v1/metrics)."
          },
          {
            "name": "username",
            "label": "Username / instance ID",
            "requiredWhen": { "field": "auth", "in": ["grafana-cloud"] },
            "hint": "Required for Grafana Cloud. Find the instance ID in your Grafana Cloud OTLP connection details."
          },
          {
            "name": "auth",
            "label": "Authentication",
            "required": true,
            "default": "grafana-cloud",
            "options": [
              { "value": "grafana-cloud", "label": "Grafana Cloud (instance ID + token)" },
              { "value": "bearer", "label": "Token only (Bearer)" },
              { "value": "none", "label": "No authentication (local collector, advanced)" }
            ]
          },
          {
            "name": "token",
            "label": "Token",
            "secret": true,
            "required": true,
            "requiredUnless": { "field": "auth", "equals": "none", "orPresent": "headers" },
            "hint": "Choose \"No authentication\" only for a local collector."
          },
          {
            "name": "headers",
            "label": "Extra headers (advanced)",
            "secret": true,
            "hint": "Optional Name=Value pairs separated by commas."
          }
        ]
      }
    ]
  },
  "hooks": [],
  "fields": [],
  "integrity": {}
}
