{
  "id": "analytics-posthog",
  "name": "PostHog",
  "version": "0.6.12",
  "sdkRange": "^0.1.0 || ^1.0.0",
  "engine": 1,
  "tier": "tier-3",
  "extensions": {
    "tovu": {
      "id": "jini/analytics-posthog"
    },
    "open-marketing": {
      "id": "jini/analytics-posthog"
    }
  },
  "capabilities": [
    "providers.register"
  ],
  "contributes": {
    "providers": [
      {
        "contract": "product_analytics",
        "id": "posthog",
        "contractVersion": 1,
        "settings": [
          {
            "name": "includePromptsAndResponses",
            "label": "Include prompts and responses",
            "default": "false",
            "options": [
              { "value": "false", "label": "Off (metadata only)" },
              { "value": "true", "label": "On" }
            ],
            "hint": "Off by default. On sends redacted, bounded prompt and response text after operator telemetry consent. Applies on next start."
          },
          {
            "name": "host",
            "label": "Region / host",
            "required": true,
            "default": "https://us.i.posthog.com",
            "options": [
              {
                "value": "https://us.i.posthog.com",
                "label": "US Cloud"
              },
              {
                "value": "https://eu.i.posthog.com",
                "label": "EU Cloud"
              }
            ],
            "allowCustom": true,
            "hint": "Custom: your self-hosted PostHog URL."
          },
          {
            "name": "apiKey",
            "label": "Project API key",
            "secret": true,
            "required": true,
            "hint": "PostHog → Project settings → Project API key (starts with phc_)."
          }
        ]
      }
    ]
  },
  "hooks": [],
  "fields": [],
  "integrity": {}
}
