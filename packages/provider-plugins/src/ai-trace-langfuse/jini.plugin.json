{
  "id": "ai-trace-langfuse",
  "name": "Langfuse AI-trace provider",
  "version": "0.6.12",
  "sdkRange": "^0.1.0 || ^1.0.0",
  "engine": 1,
  "tier": "tier-3",
  "extensions": {
    "tovu": {
      "id": "jini/ai-trace-langfuse"
    },
    "open-marketing": {
      "id": "jini/ai-trace-langfuse"
    }
  },
  "capabilities": [
    "providers.register"
  ],
  "contributes": {
    "providers": [
      {
        "contract": "ai_trace",
        "id": "langfuse",
        "contractVersion": 1,
        "settings": [
          {
            "name": "baseUrl",
            "label": "Region / host",
            "default": "https://cloud.langfuse.com",
            "options": [
              {
                "value": "https://cloud.langfuse.com",
                "label": "EU Cloud"
              },
              {
                "value": "https://us.cloud.langfuse.com",
                "label": "US Cloud"
              }
            ],
            "allowCustom": true,
            "hint": "Custom: your self-hosted Langfuse URL."
          },
          {
            "name": "publicKey",
            "label": "Public key",
            "required": true
          },
          {
            "name": "secretKey",
            "label": "Secret key",
            "secret": true,
            "required": true
          }
        ]
      }
    ]
  },
  "hooks": [],
  "fields": [],
  "integrity": {}
}
