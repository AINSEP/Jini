{
  "name": "@jini-ai/server",
  "version": "0.5.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/node-host"
  },
  "jini": {
    "domain": "server",
    "kind": "host",
    "runtime": "node",
    "admission": "locked",
    "isolation": {
      "entries": {
        "./store/projects/sqlite": "storage"
      }
    }
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./storage/legacy/sqlite": {
      "types": "./dist/storage/legacy/sqlite.d.ts",
      "import": "./dist/storage/legacy/sqlite.js",
      "default": "./dist/storage/legacy/sqlite.js"
    },
    "./store/projects/sqlite": {
      "types": "./dist/store/projects/sqlite.d.ts",
      "import": "./dist/store/projects/sqlite.js",
      "default": "./dist/store/projects/sqlite.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.typecheck.*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.tests.json && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@vitest/coverage-v8": "^2.1.9",
    "better-sqlite3": "^13.0.0",
    "@jini-ai/agent-runtime": "workspace:*",
    "@jini-ai/core": "workspace:*",
    "@jini-ai/daemon": "workspace:*",
    "@jini-ai/http-kit": "workspace:*",
    "@jini-ai/sidecar": "workspace:*",
    "express": "^4.21.0",
    "@jini-ai/db": "workspace:*",
    "@jini-ai/chat": "workspace:*",
    "@jini-ai/registry": "workspace:*"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.0",
    "@jini-ai/agent-runtime": "^0.4.1",
    "@jini-ai/daemon": "^0.5.4",
    "@jini-ai/http-kit": "^0.4.0",
    "@jini-ai/sidecar": "^0.4.0",
    "express": "^4.21.0",
    "@jini-ai/db": "^0.3.0",
    "@jini-ai/chat": "^0.5.4",
    "@jini-ai/registry": "^0.5.1"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "@jini-ai/agent-runtime": {
      "optional": true
    },
    "@jini-ai/daemon": {
      "optional": true
    },
    "@jini-ai/http-kit": {
      "optional": true
    },
    "@jini-ai/sidecar": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "@jini-ai/db": {
      "optional": true
    },
    "@jini-ai/chat": {
      "optional": true
    },
    "@jini-ai/registry": {
      "optional": true
    }
  },
  "sideEffects": false
}
