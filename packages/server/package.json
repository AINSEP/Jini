{
  "name": "@jini-ai/server",
  "version": "0.6.15",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/node-host"
  },
  "jini": {
    "domain": "server",
    "kind": "host",
    "runtime": "node",
    "admission": "locked",
    "isolation": {
      "entries": {
        "./store/projects/sqlite": "storage"
      }
    },
    "optionalPeers": {
      "better-sqlite3": "opt-in: sqlite storage — SQLite storage could not load better-sqlite3. Install better-sqlite3 to enable this feature, or check its installed version and native binaries.",
      "@jini-ai/chat": "opt-in: chat host assembly; import @jini-ai/server/storage/legacy/sqlite — Chat host assembly could not load @jini-ai/chat. Install @jini-ai/chat to enable this feature, or check its installed version and native binaries.",
      "@jini-ai/platform": "opt-in: platform-backed adapters; import @jini-ai/server/owner-store — Platform-backed adapters could not load @jini-ai/platform. Install @jini-ai/platform to enable this feature, or check its installed version and native binaries.",
      "kysely": "opt-in: sql storage adapters; import @jini-ai/server/owner-store — SQL storage adapters could not load kysely. Install kysely to enable this feature, or check its installed version and native binaries."
    }
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./storage/legacy/sqlite": {
      "types": "./dist/storage/legacy/sqlite.d.ts",
      "import": "./dist/storage/legacy/sqlite.js",
      "default": "./dist/storage/legacy/sqlite.js"
    },
    "./store/projects/sqlite": {
      "types": "./dist/store/projects/sqlite.d.ts",
      "import": "./dist/store/projects/sqlite.js",
      "default": "./dist/store/projects/sqlite.js"
    },
    "./owner-store": {
      "types": "./dist/owner-store/index.d.ts",
      "import": "./dist/owner-store/index.js",
      "default": "./dist/owner-store/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.typecheck.*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.tests.json && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@vitest/coverage-v8": "^2.1.9",
    "better-sqlite3": "^13.0.0",
    "@jini-ai/agent-runtime": "workspace:*",
    "@jini-ai/core": "workspace:*",
    "@jini-ai/daemon": "workspace:*",
    "@jini-ai/http-kit": "workspace:*",
    "@jini-ai/sidecar": "workspace:*",
    "express": "^4.21.0",
    "@jini-ai/db": "workspace:*",
    "@jini-ai/chat": "workspace:*",
    "@jini-ai/registry": "workspace:*",
    "@jini-ai/platform": "workspace:*",
    "kysely": "^0.29.6"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^",
    "@jini-ai/agent-runtime": "workspace:^",
    "@jini-ai/daemon": "workspace:^",
    "@jini-ai/db": "workspace:^",
    "@jini-ai/http-kit": "workspace:^",
    "@jini-ai/registry": "workspace:^",
    "@jini-ai/sidecar": "workspace:^"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.0",
    "express": "^4.21.0 || ^5.0.0",
    "@jini-ai/chat": "^0.6.10",
    "@jini-ai/platform": "^0.6.10",
    "kysely": "^0.29.6"
  },
  "sideEffects": false,
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "@jini-ai/chat": {
      "optional": true
    },
    "@jini-ai/platform": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  }
}
