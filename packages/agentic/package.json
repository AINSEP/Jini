{
  "name": "@jini-ai/agentic",
  "version": "0.7.3-next.2",
  "description": "Framework-free agent-control layer: page-capability vocabulary and manifests, the data-agent-* markup convention, AG-UI projection, generative-UI streams, and A2UI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/agentic"
  },
  "jini": {
    "domain": "agent",
    "kind": "capability-surface",
    "runtime": "universal",
    "entries": {
      ".": "universal",
      "./core": "universal",
      "./render-surface": "universal",
      "./dom": "browser",
      "./dom/admin-page-tools": "browser",
      "./skills/install": "node",
      "./skills/install/node": "node",
      "./skills/tools": "node",
      "./skills/site/live-registration": "node",
      "./skills/site/install-service": "node",
      "./skills/site/install-tool": "node",
      "./skills/site/layout": "node",
      "./skills/site/tool-registrations": "node",
      "./react/skills/api": "browser"
    },
    "optionalPeers": {
      "@jini-ai/protocol": "opt-in: agent protocol adapters; import @jini-ai/agentic/render-surface — Agent protocol adapters could not load @jini-ai/protocol. Install @jini-ai/protocol to enable this feature, or check its installed version and native binaries.",
      "react": "opt-in: react browser bindings; import @jini-ai/agentic/react/skills/api — React browser bindings could not load react. Install react to enable this feature, or check its installed version."
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./render-surface": {
      "types": "./dist/core/render-surface.d.ts",
      "import": "./dist/core/render-surface.js",
      "default": "./dist/core/render-surface.js"
    },
    "./dom": {
      "types": "./dist/core/dom/index.d.ts",
      "import": "./dist/core/dom/index.js",
      "default": "./dist/core/dom/index.js"
    },
    "./dom/admin-page-tools": {
      "types": "./dist/core/dom/admin-page-tools.d.ts",
      "import": "./dist/core/dom/admin-page-tools.js",
      "default": "./dist/core/dom/admin-page-tools.js"
    },
    "./skills/install": {
      "types": "./dist/skills/install/index.d.ts",
      "import": "./dist/skills/install/index.js",
      "default": "./dist/skills/install/index.js"
    },
    "./skills/install/node": {
      "types": "./dist/skills/install/node-filesystem.d.ts",
      "import": "./dist/skills/install/node-filesystem.js",
      "default": "./dist/skills/install/node-filesystem.js"
    },
    "./skills/tools": {
      "types": "./dist/skills/tools/index.d.ts",
      "import": "./dist/skills/tools/index.js",
      "default": "./dist/skills/tools/index.js"
    },
    "./skills/site/live-registration": {
      "types": "./dist/skills/site/live-registration.d.ts",
      "import": "./dist/skills/site/live-registration.js",
      "default": "./dist/skills/site/live-registration.js"
    },
    "./skills/site/install-service": {
      "types": "./dist/skills/site/install-service.d.ts",
      "import": "./dist/skills/site/install-service.js",
      "default": "./dist/skills/site/install-service.js"
    },
    "./skills/site/install-tool": {
      "types": "./dist/skills/site/install-tool.d.ts",
      "import": "./dist/skills/site/install-tool.js",
      "default": "./dist/skills/site/install-tool.js"
    },
    "./skills/site/layout": {
      "types": "./dist/skills/site/layout.d.ts",
      "import": "./dist/skills/site/layout.js",
      "default": "./dist/skills/site/layout.js"
    },
    "./skills/site/tool-registrations": {
      "types": "./dist/skills/site/tool-registrations.d.ts",
      "import": "./dist/skills/site/tool-registrations.js",
      "default": "./dist/skills/site/tool-registrations.js"
    },
    "./react/skills/api": {
      "types": "./dist/react/skills/api.d.ts",
      "import": "./dist/react/skills/api.js",
      "default": "./dist/react/skills/api.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.dom.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dom.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^26.1.0",
    "@jini-ai/protocol": "workspace:^",
    "zod": "^4.6.6",
    "@jini-ai/core": "workspace:^",
    "react": "^19.2.0",
    "@types/react": "^19.2.0"
  },
  "peerDependencies": {
    "@jini-ai/protocol": "^0.7.3-next.2",
    "@jini-ai/core": "^0.7.3-next.2",
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@jini-ai/protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.6.6"
  }
}
