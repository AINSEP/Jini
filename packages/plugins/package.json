{
  "name": "@jini-ai/plugins",
  "version": "0.7.3-next.2",
  "description": "Host-independent extension glue and site-plugin runtime with injected SDK, trust, archive and storage ports.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugins"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./glue": "universal",
      "./host": "universal",
      "./host/node": "node",
      "./host/worker": "node",
      "./host/sql": "node",
      "./host/tools": "node",
      "./runtime/install-consent": "universal",
      "./runtime/plugin-tool-ids": "universal",
      "./runtime/plugin-export": "universal",
      "./runtime/agent-tools": "universal",
      "./runtime/plugin-tool-messages": "universal",
      "./runtime/source-tool-catalog": "universal",
      "./runtime/install-tool-catalog": "universal",
      "./runtime/capability-card": "universal",
      "./runtime/plugin-host-copy": "universal",
      "./runtime/enable-confirmation-ui": "universal",
      "./runtime/uninstall-confirmation-ui": "universal",
      "./site/lipay/manifest": "universal",
      "./site/store/manifest": "universal"
    },
    "isolation": {
      "forbidden": {
        "./host": [
          "node:"
        ]
      }
    },
    "optionalPeers": {
      "semver": "opt-in: plugin version compatibility; import @jini-ai/plugins/host — Plugin version compatibility could not load semver. Install semver to enable this feature, or check its installed version and native binaries.",
      "kysely": "opt-in: sql storage adapters; import @jini-ai/plugins/host/sql — SQL storage adapters could not load kysely. Install kysely to enable this feature, or check its installed version and native binaries."
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./glue": {
      "types": "./dist/glue/index.d.ts",
      "import": "./dist/glue/index.js",
      "default": "./dist/glue/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js",
      "default": "./dist/host/index.js"
    },
    "./host/node": {
      "types": "./dist/host/node/index.d.ts",
      "import": "./dist/host/node/index.js",
      "default": "./dist/host/node/index.js"
    },
    "./host/worker": {
      "types": "./dist/host/worker/index.d.ts",
      "import": "./dist/host/worker/index.js",
      "default": "./dist/host/worker/index.js"
    },
    "./host/sql": {
      "types": "./dist/host/sql/index.d.ts",
      "import": "./dist/host/sql/index.js",
      "default": "./dist/host/sql/index.js"
    },
    "./host/tools": {
      "types": "./dist/host/tools/index.d.ts",
      "import": "./dist/host/tools/index.js",
      "default": "./dist/host/tools/index.js"
    },
    "./runtime/install-consent": {
      "types": "./dist/runtime/install-consent.d.ts",
      "import": "./dist/runtime/install-consent.js",
      "default": "./dist/runtime/install-consent.js"
    },
    "./runtime/plugin-tool-ids": {
      "types": "./dist/runtime/plugin-tool-ids.d.ts",
      "import": "./dist/runtime/plugin-tool-ids.js",
      "default": "./dist/runtime/plugin-tool-ids.js"
    },
    "./runtime/plugin-export": {
      "types": "./dist/runtime/plugin-export.d.ts",
      "import": "./dist/runtime/plugin-export.js",
      "default": "./dist/runtime/plugin-export.js"
    },
    "./runtime/agent-tools": {
      "types": "./dist/runtime/agent-tools.d.ts",
      "import": "./dist/runtime/agent-tools.js",
      "default": "./dist/runtime/agent-tools.js"
    },
    "./runtime/plugin-tool-messages": {
      "types": "./dist/runtime/plugin-tool-messages.d.ts",
      "import": "./dist/runtime/plugin-tool-messages.js",
      "default": "./dist/runtime/plugin-tool-messages.js"
    },
    "./runtime/source-tool-catalog": {
      "types": "./dist/runtime/source-tool-catalog.d.ts",
      "import": "./dist/runtime/source-tool-catalog.js",
      "default": "./dist/runtime/source-tool-catalog.js"
    },
    "./runtime/install-tool-catalog": {
      "types": "./dist/runtime/install-tool-catalog.d.ts",
      "import": "./dist/runtime/install-tool-catalog.js",
      "default": "./dist/runtime/install-tool-catalog.js"
    },
    "./runtime/capability-card": {
      "types": "./dist/runtime/capability-card.d.ts",
      "import": "./dist/runtime/capability-card.js",
      "default": "./dist/runtime/capability-card.js"
    },
    "./runtime/plugin-host-copy": {
      "types": "./dist/runtime/plugin-host-copy.d.ts",
      "import": "./dist/runtime/plugin-host-copy.js",
      "default": "./dist/runtime/plugin-host-copy.js"
    },
    "./runtime/enable-confirmation-ui": {
      "types": "./dist/runtime/enable-confirmation-ui.d.ts",
      "import": "./dist/runtime/enable-confirmation-ui.js",
      "default": "./dist/runtime/enable-confirmation-ui.js"
    },
    "./runtime/uninstall-confirmation-ui": {
      "types": "./dist/runtime/uninstall-confirmation-ui.d.ts",
      "import": "./dist/runtime/uninstall-confirmation-ui.js",
      "default": "./dist/runtime/uninstall-confirmation-ui.js"
    },
    "./site/lipay/manifest": {
      "types": "./dist/site/lipay/manifest.d.ts",
      "import": "./dist/site/lipay/manifest.js",
      "default": "./dist/site/lipay/manifest.js"
    },
    "./site/store/manifest": {
      "types": "./dist/site/store/manifest.d.ts",
      "import": "./dist/site/store/manifest.js",
      "default": "./dist/site/store/manifest.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "semver": "^7.6.2",
    "kysely": "^0.29.6"
  },
  "devDependencies": {
    "@jini-ai/core": "workspace:^",
    "@jini-ai/platform": "workspace:^",
    "semver": "^7.6.2",
    "@types/semver": "^7.5.8",
    "kysely": "^0.29.6",
    "@jini-ai/db": "workspace:*"
  },
  "peerDependenciesMeta": {
    "semver": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  }
}
