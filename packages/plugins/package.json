{
  "name": "@jini-ai/plugins",
  "version": "0.4.0",
  "description": "Host-independent extension glue: injected manifest vocabularies, capability gates, dispatch and attachment delegates. Host plugin lifecycle remains reserved.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugins"
  },
  "private": true,
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./glue": "universal"
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./glue": {
      "types": "./dist/glue/index.d.ts",
      "import": "./dist/glue/index.js",
      "default": "./dist/glue/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
