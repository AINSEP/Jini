{
  "name": "@jini-ai/plugins",
  "version": "0.1.0",
  "description": "Namespace package for plugin packaging in Jini, one independently-importable subpath per format: the third-party Agent Plugins open standard (./agent-plugins), and Jini's own host-extension plugins (./host, reserved — see README).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugins"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./agent-plugins": "universal"
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./agent-plugins": {
      "types": "./dist/agent-plugins/index.d.ts",
      "import": "./dist/agent-plugins/index.js",
      "default": "./dist/agent-plugins/index.js"
    },
    "./samples/*": "./samples/*"
  },
  "typesVersions": {
    "*": {
      "agent-plugins": [
        "./dist/agent-plugins/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "samples",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9"
  }
}
