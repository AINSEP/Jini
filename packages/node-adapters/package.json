{
  "name": "@jini-ai/node-adapters",
  "version": "0.7.3-next.0",
  "description": "Node bindings of the engine's runtime ports (file lock, atomic file writer, process control) over @jini-ai/platform functions. Bindings only: assembles nothing.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/node-adapters"
  },
  "jini": {
    "domain": "platform",
    "kind": "runtime-adapter",
    "runtime": "node",
    "entries": {
      "./fs": "node",
      "./process": "node"
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js",
      "default": "./dist/fs.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "import": "./dist/process.js",
      "default": "./dist/process.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@jini-ai/core": "workspace:^",
    "@jini-ai/platform": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9"
  }
}
