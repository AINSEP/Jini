{
  "name": "@jini-ai/plugin-jev",
  "version": "0.6.17",
  "description": "Independently installable Jev (TypeSafe) design guidance skill in the portable Agent Plugins format.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugin-jev"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./package.json": "universal",
      "./plugin.json": "universal",
      "./jev/*": "universal"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./plugin.json": "./jev/plugin.json",
    "./jev/*": "./jev/*"
  },
  "files": ["jev", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts jev",
    "prepack": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts jev"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
