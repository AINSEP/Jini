{
  "name": "@jini-ai/plugin-google-workspace",
  "version": "0.6.17",
  "description": "Independently installable Google Workspace Agent Plugin (Google sign-in, Google Sheets tools, admin panels and a form destination) in the portable Agent Plugins format.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugin-google-workspace"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./package.json": "universal",
      "./plugin.json": "universal",
      "./google-workspace/*": "universal"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./plugin.json": "./google-workspace/plugin.json",
    "./google-workspace/*": "./google-workspace/*"
  },
  "files": ["google-workspace", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts google-workspace",
    "prepack": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts google-workspace"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
