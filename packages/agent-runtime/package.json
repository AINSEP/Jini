{
  "name": "@jini-ai/agent-runtime",
  "version": "0.4.11",
  "description": "Coding-agent runtime adapters: runtime registry, detection, launch, stream parsers, and the ACP/pi-rpc subprocess transport.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/agent-runtime"
  },
  "jini": {
    "domain": "agent",
    "kind": "runtime",
    "runtime": "node",
    "entries": {
      ".": "node",
      "./providers/tool-turn": "node",
      "./model-catalog/cache": "universal",
      "./providers/sse-decode": "universal",
      "./model-discovery": "node"
    },
    "isolation": {
      "forbidden": {
        "./model-discovery": [
          "node:child_process",
          "child_process",
          "node:fs",
          "fs",
          "./model-discovery-adapters.js",
          "./model-discovery-native.js",
          "./model-discovery-sdk.js"
        ]
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./providers/tool-turn": {
      "types": "./dist/providers/tool-turn.d.ts",
      "import": "./dist/providers/tool-turn.js",
      "default": "./dist/providers/tool-turn.js"
    },
    "./model-catalog/cache": {
      "types": "./dist/model-catalog-cache.d.ts",
      "import": "./dist/model-catalog-cache.js",
      "default": "./dist/model-catalog-cache.js"
    },
    "./providers/sse-decode": {
      "types": "./dist/providers/sse-decode.d.ts",
      "import": "./dist/providers/sse-decode.js",
      "default": "./dist/providers/sse-decode.js"
    },
    "./model-discovery": {
      "types": "./dist/model-discovery.d.ts",
      "import": "./dist/model-discovery.js",
      "default": "./dist/model-discovery.js"
    }
  },
  "typesVersions": {
    "*": {
      "providers/tool-turn": [
        "./dist/providers/tool-turn.d.ts"
      ],
      "model-catalog/cache": [
        "./dist/model-catalog-cache.d.ts"
      ],
      "providers/sse-decode": [
        "./dist/providers/sse-decode.d.ts"
      ],
      "model-discovery": [
        "./dist/model-discovery.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@jini-ai/integrations": "workspace:^",
    "@vitest/coverage-v8": "^2.1.9",
    "@jini-ai/platform": "workspace:^",
    "@jini-ai/protocol": "workspace:^",
    "@jini-ai/core": "^0.4.0"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^",
    "@jini-ai/oauth": "workspace:^"
  },
  "peerDependencies": {
    "@jini-ai/integrations": "^0.4.2",
    "@github/copilot-sdk": "*",
    "@jini-ai/platform": "^0.5.5",
    "@jini-ai/protocol": "^0.4.4"
  },
  "peerDependenciesMeta": {
    "@jini-ai/integrations": {
      "optional": true
    },
    "@github/copilot-sdk": {
      "optional": true
    },
    "@jini-ai/platform": {
      "optional": true
    },
    "@jini-ai/protocol": {
      "optional": true
    }
  }
}
