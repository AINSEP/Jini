{
  "name": "@jini-ai/plugin-github-pages",
  "version": "0.6.17",
  "description": "Independently installable GitHub Pages static-site publishing in the portable Agent Plugins format.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugin-github-pages"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./package.json": "universal",
      "./plugin.json": "universal",
      "./github-pages/*": "universal"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./plugin.json": "./github-pages/plugin.json",
    "./github-pages/*": "./github-pages/*"
  },
  "files": ["github-pages", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts github-pages",
    "prepack": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts github-pages"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
