{
  "name": "@jini-ai/registry",
  "version": "0.6.19",
  "description": "Pluggable content-registry backends (static, GitHub, database) and semver specifier resolution over @jini-ai/protocol’s registry wire types.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/registry"
  },
  "jini": {
    "domain": "capability",
    "kind": "registry",
    "runtime": "node",
    "entries": {
      ".": "node",
      "./tool-catalog": "universal",
      "./tool-catalog/sqlite": "node",
      "./tool-catalog-builder": "universal",
      "./tool-catalog-builder/sqlite": "node"
    },
    "isolation": {
      "entries": {
        "./tool-catalog-builder": "tool-catalog",
        "./tool-catalog-builder/sqlite": "tool-catalog"
      }
    },
    "optionalPeers": {
      "better-sqlite3": "opt-in: sqlite storage — SQLite storage could not load better-sqlite3. Install better-sqlite3 to enable this feature, or check its installed version and native binaries.",
      "@jini-ai/db": "opt-in: database-backed adapters — Database-backed adapters could not load @jini-ai/db. Install @jini-ai/db to enable this feature, or check its installed version and native binaries."
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tool-catalog": {
      "types": "./dist/tool-catalog/index.d.ts",
      "import": "./dist/tool-catalog/index.js",
      "default": "./dist/tool-catalog/index.js"
    },
    "./tool-catalog/sqlite": {
      "types": "./dist/tool-catalog/sqlite.d.ts",
      "import": "./dist/tool-catalog/sqlite.js",
      "default": "./dist/tool-catalog/sqlite.js"
    },
    "./tool-catalog-builder": {
      "types": "./dist/tool-catalog-builder/index.d.ts",
      "import": "./dist/tool-catalog-builder/index.js",
      "default": "./dist/tool-catalog-builder/index.js"
    },
    "./tool-catalog-builder/sqlite": {
      "types": "./dist/tool-catalog-builder/sqlite.d.ts",
      "import": "./dist/tool-catalog-builder/sqlite.js",
      "default": "./dist/tool-catalog-builder/sqlite.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini-ai/protocol": "workspace:^",
    "@jini-ai/core": "workspace:^",
    "@jini-ai/platform": "workspace:^"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.0",
    "@jini-ai/db": "^0.6.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^13.0.0",
    "@jini-ai/db": "workspace:*",
    "@jini-ai/platform": "workspace:^",
    "@jini-ai/protocol": "workspace:^",
    "@jini-ai/core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "@jini-ai/db": {
      "optional": true
    }
  }
}
