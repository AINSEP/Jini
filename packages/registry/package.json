{
  "name": "@jini-ai/registry",
  "version": "0.1.2",
  "description": "Pluggable content-registry backends (static, GitHub, database) and semver specifier resolution over @jini-ai/protocol’s registry wire types.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/registry"
  },
  "jini": {
    "domain": "capability",
    "kind": "registry",
    "runtime": "node"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini-ai/protocol": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^11.10.0"
  }
}
