{
  "name": "@jini-ai/core",
  "version": "0.6.23",
  "description": "The Jini kernel: typed DI tokens, pack composition and lifecycle, the tool registry, redaction, and origin/API-token auth primitives. Zero dependencies.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/core"
  },
  "jini": {
    "domain": "engine",
    "kind": "kernel",
    "runtime": "universal",
    "entries": {
      ".": "universal",
      "./composition": "universal",
      "./gated-mutations": "universal",
      "./model-facing-tool-errors": "universal",
      "./contribution-registry": "universal",
      "./provider-registry": "universal",
      "./object-store": "universal",
      "./naming": "universal",
      "./oauth-callback-fields": "universal",
      "./records": "universal",
      "./primitives": "universal",
      "./fetch": "universal",
      "./text": "universal",
      "./settings": "universal",
      "./settings/express": "node",
      "./plugin-directory": "universal",
      "./filesystem": "universal",
      "./optional-peer": "universal",
      "./contracts/cards": "universal",
      "./contracts/credentials": "universal",
      "./contracts/mail": "universal",
      "./contracts/vault": "universal",
      "./contracts/oauth": "universal",
      "./contracts/content-types": "universal",
      "./contracts/hosted-mcp": "universal"
    },
    "isolation": {
      "entries": {
        "./primitives": "core",
        "./fetch": "fetch",
        "./settings": "settings",
        "./settings/express": "settings",
        "./provider-registry": "providers",
        "./object-store": "providers"
      },
      "domains": {
        "fetch": [
          "src/fetch"
        ],
        "settings": [
          "src/settings"
        ],
        "providers": [
          "src/provider-registry.ts",
          "src/object-store.ts"
        ]
      },
      "shared": [
        "src/tool-permissions.ts",
        "src/records.ts"
      ],
      "forbidden": {
        "universal": [
          "node:",
          "express",
          "react",
          "@jini-ai/cms"
        ],
        ".": [
          "node:",
          "express",
          "react",
          "@jini-ai/cms",
          "@jini-ai/core/settings",
          "./settings",
          "../settings"
        ],
        "./settings/express": [
          "@jini-ai/cms"
        ]
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./composition": {
      "types": "./dist/composition.d.ts",
      "import": "./dist/composition.js",
      "default": "./dist/composition.js"
    },
    "./gated-mutations": {
      "types": "./dist/gated-mutations.d.ts",
      "import": "./dist/gated-mutations.js",
      "default": "./dist/gated-mutations.js"
    },
    "./model-facing-tool-errors": {
      "types": "./dist/model-facing-tool-errors.d.ts",
      "import": "./dist/model-facing-tool-errors.js",
      "default": "./dist/model-facing-tool-errors.js"
    },
    "./contribution-registry": {
      "types": "./dist/contribution-registry.d.ts",
      "import": "./dist/contribution-registry.js",
      "default": "./dist/contribution-registry.js"
    },
    "./provider-registry": {
      "types": "./dist/provider-registry.d.ts",
      "import": "./dist/provider-registry.js",
      "default": "./dist/provider-registry.js"
    },
    "./object-store": {
      "types": "./dist/object-store.d.ts",
      "import": "./dist/object-store.js",
      "default": "./dist/object-store.js"
    },
    "./naming": {
      "types": "./dist/naming.d.ts",
      "import": "./dist/naming.js",
      "default": "./dist/naming.js"
    },
    "./oauth-callback-fields": {
      "types": "./dist/oauth-callback-fields.d.ts",
      "import": "./dist/oauth-callback-fields.js",
      "default": "./dist/oauth-callback-fields.js"
    },
    "./records": {
      "types": "./dist/records.d.ts",
      "import": "./dist/records.js",
      "default": "./dist/records.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "default": "./dist/primitives/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch/index.d.ts",
      "import": "./dist/fetch/index.js",
      "default": "./dist/fetch/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js",
      "default": "./dist/text/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js",
      "default": "./dist/settings/index.js"
    },
    "./settings/express": {
      "types": "./dist/settings/express/index.d.ts",
      "import": "./dist/settings/express/index.js",
      "default": "./dist/settings/express/index.js"
    },
    "./plugin-directory": {
      "types": "./plugin-directory.d.ts",
      "import": "./plugin-directory.js",
      "default": "./plugin-directory.js"
    },
    "./filesystem": {
      "types": "./dist/filesystem.d.ts",
      "import": "./dist/filesystem.js",
      "default": "./dist/filesystem.js"
    },
    "./optional-peer": {
      "types": "./dist/optional-peer.d.ts",
      "import": "./dist/optional-peer.js",
      "default": "./dist/optional-peer.js"
    },
    "./contracts/cards": {
      "types": "./dist/contracts/cards.d.ts",
      "import": "./dist/contracts/cards.js",
      "default": "./dist/contracts/cards.js"
    },
    "./contracts/credentials": {
      "types": "./dist/contracts/credentials.d.ts",
      "import": "./dist/contracts/credentials.js",
      "default": "./dist/contracts/credentials.js"
    },
    "./contracts/mail": {
      "types": "./dist/contracts/mail.d.ts",
      "import": "./dist/contracts/mail.js",
      "default": "./dist/contracts/mail.js"
    },
    "./contracts/vault": {
      "types": "./dist/contracts/vault.d.ts",
      "import": "./dist/contracts/vault.js",
      "default": "./dist/contracts/vault.js"
    },
    "./contracts/oauth": {
      "types": "./dist/contracts/oauth.d.ts",
      "import": "./dist/contracts/oauth.js",
      "default": "./dist/contracts/oauth.js"
    },
    "./contracts/content-types": {
      "types": "./dist/contracts/content-types.d.ts",
      "import": "./dist/contracts/content-types.js",
      "default": "./dist/contracts/content-types.js"
    },
    "./contracts/hosted-mcp": {
      "types": "./dist/contracts/hosted-mcp.d.ts",
      "import": "./dist/contracts/hosted-mcp.js",
      "default": "./dist/contracts/hosted-mcp.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.typecheck.*",
    "!dist/**/*.map",
    "plugin-directory.js",
    "plugin-directory.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "express": "^4.21.0",
    "@types/express": "^4.17.21"
  }
}
