{
  "name": "@jini-ai/integrations",
  "version": "0.7.3-next.2",
  "description": "Third-party vendor integrations and outbound services, each independently importable: media generation, credentialed HTTP and webhooks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/integrations"
  },
  "jini": {
    "domain": "integration",
    "kind": "vendor-integration-gateway",
    "runtime": "node",
    "entries": {
      "./media-providers": "node",
      "./media-providers/catalog": "universal",
      "./credentialed-http": "node",
      "./credentialed-http/sets": "node",
      "./webhooks": "node",
      "./api-connections": "node",
      "./api-connections/hosted-mcp": "node",
      "./media-providers/node": "node",
      "./saved-requests": "node",
      "./credentialed-http/tools": "node",
      "./webhooks/tools": "node",
      "./webhooks/site/signing": "node",
      "./webhooks/site/signing.keyring": "node",
      "./webhooks/site/subscriptions": "node",
      "./vendor-credentials/abort-guarded-repo": "node",
      "./webhooks/sql": "node",
      "./custom-credentials/card-token": "node",
      "./custom-credentials/credential-recovery": "node"
    },
    "optionalPeers": {
      "better-sqlite3": "opt-in: sqlite storage; import @jini-ai/integrations/media-providers — SQLite storage could not load better-sqlite3. Install better-sqlite3 to enable this feature, or check its installed version and native binaries.",
      "@jini-ai/platform": "opt-in: platform-backed adapters; import @jini-ai/integrations/media-providers — Platform-backed adapters could not load @jini-ai/platform. Install @jini-ai/platform to enable this feature, or check its installed version and native binaries.",
      "@cfworker/json-schema": "opt-in: json schema validation; import @jini-ai/integrations/saved-requests — JSON Schema validation could not load @cfworker/json-schema. Install @cfworker/json-schema to enable this feature, or check its installed version and native binaries.",
      "kysely": "opt-in: sql storage adapters; import @jini-ai/integrations/webhooks/sql — SQL storage adapters could not load kysely. Install kysely to enable this feature, or check its installed version and native binaries."
    },
    "isolation": {
      "entries": {
        "./custom-credentials/card-token": "credentialed-http",
        "./custom-credentials/credential-recovery": "credentialed-http"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./media-providers": {
      "types": "./dist/media-providers/index.d.ts",
      "import": "./dist/media-providers/index.js",
      "default": "./dist/media-providers/index.js"
    },
    "./media-providers/catalog": {
      "types": "./dist/media-providers/catalog.d.ts",
      "import": "./dist/media-providers/catalog.js",
      "default": "./dist/media-providers/catalog.js"
    },
    "./credentialed-http": {
      "types": "./dist/credentialed-http/index.d.ts",
      "import": "./dist/credentialed-http/index.js",
      "default": "./dist/credentialed-http/index.js"
    },
    "./credentialed-http/sets": {
      "types": "./dist/credentialed-http/sets/index.d.ts",
      "import": "./dist/credentialed-http/sets/index.js",
      "default": "./dist/credentialed-http/sets/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js",
      "default": "./dist/webhooks/index.js"
    },
    "./api-connections": {
      "types": "./dist/api-connections/index.d.ts",
      "import": "./dist/api-connections/index.js",
      "default": "./dist/api-connections/index.js"
    },
    "./api-connections/hosted-mcp": {
      "types": "./dist/api-connections/hosted-mcp/index.d.ts",
      "import": "./dist/api-connections/hosted-mcp/index.js",
      "default": "./dist/api-connections/hosted-mcp/index.js"
    },
    "./media-providers/node": {
      "types": "./dist/media-providers/dispatch/node.d.ts",
      "import": "./dist/media-providers/dispatch/node.js",
      "default": "./dist/media-providers/dispatch/node.js"
    },
    "./saved-requests": {
      "types": "./dist/saved-requests/index.d.ts",
      "import": "./dist/saved-requests/index.js",
      "default": "./dist/saved-requests/index.js"
    },
    "./credentialed-http/tools": {
      "types": "./dist/credentialed-http/tools/index.d.ts",
      "import": "./dist/credentialed-http/tools/index.js",
      "default": "./dist/credentialed-http/tools/index.js"
    },
    "./webhooks/tools": {
      "types": "./dist/webhooks/tools/index.d.ts",
      "import": "./dist/webhooks/tools/index.js",
      "default": "./dist/webhooks/tools/index.js"
    },
    "./webhooks/site/signing": {
      "types": "./dist/webhooks/site/signing.d.ts",
      "import": "./dist/webhooks/site/signing.js",
      "default": "./dist/webhooks/site/signing.js"
    },
    "./webhooks/site/signing.keyring": {
      "types": "./dist/webhooks/site/signing.keyring.d.ts",
      "import": "./dist/webhooks/site/signing.keyring.js",
      "default": "./dist/webhooks/site/signing.keyring.js"
    },
    "./webhooks/site/subscriptions": {
      "types": "./dist/webhooks/site/subscriptions.d.ts",
      "import": "./dist/webhooks/site/subscriptions.js",
      "default": "./dist/webhooks/site/subscriptions.js"
    },
    "./vendor-credentials/abort-guarded-repo": {
      "types": "./dist/vendor-credentials/abort-guarded-repo.d.ts",
      "import": "./dist/vendor-credentials/abort-guarded-repo.js",
      "default": "./dist/vendor-credentials/abort-guarded-repo.js"
    },
    "./webhooks/sql": {
      "types": "./dist/webhooks/sql/index.d.ts",
      "import": "./dist/webhooks/sql/index.js",
      "default": "./dist/webhooks/sql/index.js"
    },
    "./custom-credentials/card-token": {
      "types": "./dist/custom-credentials/card-token.d.ts",
      "import": "./dist/custom-credentials/card-token.js",
      "default": "./dist/custom-credentials/card-token.js"
    },
    "./custom-credentials/credential-recovery": {
      "types": "./dist/custom-credentials/credential-recovery.d.ts",
      "import": "./dist/custom-credentials/credential-recovery.js",
      "default": "./dist/custom-credentials/credential-recovery.js"
    }
  },
  "typesVersions": {
    "*": {
      "media-providers": [
        "./dist/media-providers/index.d.ts"
      ],
      "media-providers/catalog": [
        "./dist/media-providers/catalog.d.ts"
      ],
      "credentialed-http": [
        "./dist/credentialed-http/index.d.ts"
      ],
      "credentialed-http/sets": [
        "./dist/credentialed-http/sets/index.d.ts"
      ],
      "webhooks": [
        "./dist/webhooks/index.d.ts"
      ],
      "api-connections": [
        "./dist/api-connections/index.d.ts"
      ],
      "media-providers/node": [
        "./dist/media-providers/dispatch/node.d.ts"
      ],
      "saved-requests": [
        "./dist/saved-requests/index.d.ts"
      ],
      "credentialed-http/tools": [
        "./dist/credentialed-http/tools/index.d.ts"
      ],
      "webhooks/tools": [
        "./dist/webhooks/tools/index.d.ts"
      ],
      "webhooks/site/signing": [
        "./dist/webhooks/site/signing.d.ts"
      ],
      "webhooks/site/signing.keyring": [
        "./dist/webhooks/site/signing.keyring.d.ts"
      ],
      "webhooks/site/subscriptions": [
        "./dist/webhooks/site/subscriptions.d.ts"
      ],
      "vendor-credentials/abort-guarded-repo": [
        "./dist/vendor-credentials/abort-guarded-repo.d.ts"
      ],
      "webhooks/sql": [
        "./dist/webhooks/sql/index.d.ts"
      ],
      "custom-credentials/card-token": [
        "./dist/custom-credentials/card-token.d.ts"
      ],
      "custom-credentials/credential-recovery": [
        "./dist/custom-credentials/credential-recovery.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.0",
    "@jini-ai/platform": "^0.7.3-next.2",
    "@cfworker/json-schema": "^4.1.1",
    "kysely": "^0.29.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^13.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@jini-ai/core": "workspace:*",
    "@jini-ai/platform": "workspace:*",
    "@jini-ai/oauth": "workspace:*",
    "@cfworker/json-schema": "^4.1.1",
    "kysely": "^0.29.6",
    "@electric-sql/pglite": "0.5.8",
    "@jini-ai/db": "workspace:*"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "@jini-ai/platform": {
      "optional": true
    },
    "@cfworker/json-schema": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  }
}
