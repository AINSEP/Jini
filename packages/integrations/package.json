{
  "name": "@jini-ai/integrations",
  "version": "0.4.1",
  "description": "Third-party vendor integrations and outbound services, each independently importable: media generation, credentialed HTTP and webhooks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/integrations"
  },
  "jini": {
    "domain": "integration",
    "kind": "vendor-integration-gateway",
    "runtime": "node",
    "entries": {
      "./media-providers": "node",
      "./media-providers/catalog": "universal",
      "./credentialed-http": "node",
      "./webhooks": "node"
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./media-providers": {
      "types": "./dist/media-providers/index.d.ts",
      "import": "./dist/media-providers/index.js",
      "default": "./dist/media-providers/index.js"
    },
    "./media-providers/catalog": {
      "types": "./dist/media-providers/catalog.d.ts",
      "import": "./dist/media-providers/catalog.js",
      "default": "./dist/media-providers/catalog.js"
    },
    "./credentialed-http": {
      "types": "./dist/credentialed-http/index.d.ts",
      "import": "./dist/credentialed-http/index.js",
      "default": "./dist/credentialed-http/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js",
      "default": "./dist/webhooks/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "media-providers": [
        "./dist/media-providers/index.d.ts"
      ],
      "media-providers/catalog": [
        "./dist/media-providers/catalog.d.ts"
      ],
      "credentialed-http": [
        "./dist/credentialed-http/index.d.ts"
      ],
      "webhooks": [
        "./dist/webhooks/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.0",
    "@jini-ai/platform": "^0.5.1"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "@jini-ai/platform": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^13.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@jini-ai/core": "workspace:*",
    "@jini-ai/platform": "workspace:*",
    "@jini-ai/agent-plugins": "workspace:*"
  }
}
