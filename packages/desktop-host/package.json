{
  "name": "@jini/desktop-host",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/leonaburime-ucla/Jini.git", "directory": "packages/desktop-host" },
  "jini": {
    "domain": "platform",
    "kind": "host",
    "runtime": "desktop",
    "admission": "incubating"
  },
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./bridge-testing": { "types": "./dist/bridge-testing.d.ts", "import": "./dist/bridge-testing.js" }
  },
  "files": ["dist"],
  "publishConfig": { "access": "restricted", "registry": "https://registry.npmjs.org" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9"
  }
}
