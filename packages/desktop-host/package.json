{
  "name": "@jini-ai/desktop-host",
  "version": "0.7.3-next.2",
  "description": "Shell-agnostic desktop-host ports: single-instance lock, window lifecycle, protocol handling, sidecar launch, paths, and config. Electron and Tauri assemblies live behind ./electron and ./tauri.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/desktop-host"
  },
  "jini": {
    "domain": "platform",
    "kind": "host",
    "runtime": "desktop",
    "entries": {
      ".": "desktop",
      "./bridge-testing": "universal",
      "./app-version": "universal",
      "./render-bridge": "node",
      "./electron": "desktop",
      "./tauri": "desktop",
      "./shutdown": "node",
      "./electron/navigation-policy": "desktop",
      "./electron/updates": "desktop",
      "./electron/preferences": "desktop",
      "./node-toolchain": "node",
      "./electron/usability": "desktop",
      "./speech": "desktop",
      "./speech/macos": "node",
      "./speech/macos/speech-helper.swift": "node",
      "./bridge": "universal",
      "./shell/find-in-page-verify": "universal",
      "./shell/js-backslide-guard": "universal",
      "./shell/pty-helpers": "node",
      "./shell/instance-presence": "node",
      "./shell/auto-update-controller": "node",
      "./shell/spellcheck-menu": "desktop",
      "./electron/selftest": "desktop",
      "./shell/guest-navigation": "desktop",
      "./shell/site-presence": "universal",
      "./electron/handoff": "desktop",
      "./electron/preload": "desktop",
      "./electron/webview": "desktop",
      "./electron/session-bootstrap": "desktop",
      "./electron/windows": "desktop"
    },
    "isolation": {
      "entries": {
        "./bridge-testing": "bridge",
        "./shell/instance-presence": "electron",
        "./shell/auto-update-controller": "electron",
        "./shell/spellcheck-menu": "electron",
        "./shell/guest-navigation": "electron"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./render-bridge": {
      "types": "./dist/render-bridge.d.ts",
      "import": "./dist/render-bridge.js",
      "default": "./dist/render-bridge.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./bridge-testing": {
      "types": "./dist/bridge-testing.d.ts",
      "import": "./dist/bridge-testing.js",
      "default": "./dist/bridge-testing.js"
    },
    "./app-version": {
      "types": "./dist/app-version/index.d.ts",
      "import": "./dist/app-version/index.js",
      "default": "./dist/app-version/index.js"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "import": "./dist/electron/index.js",
      "default": "./dist/electron/index.js"
    },
    "./tauri": {
      "types": "./dist/tauri/index.d.ts",
      "import": "./dist/tauri/index.js",
      "default": "./dist/tauri/index.js"
    },
    "./shutdown": {
      "types": "./dist/shutdown/index.d.ts",
      "import": "./dist/shutdown/index.js",
      "default": "./dist/shutdown/index.js"
    },
    "./electron/navigation-policy": {
      "types": "./dist/electron/navigation-policy/index.d.ts",
      "import": "./dist/electron/navigation-policy/index.js",
      "default": "./dist/electron/navigation-policy/index.js"
    },
    "./electron/updates": {
      "types": "./dist/electron/updates/index.d.ts",
      "import": "./dist/electron/updates/index.js",
      "default": "./dist/electron/updates/index.js"
    },
    "./electron/preferences": {
      "types": "./dist/electron/preferences/index.d.ts",
      "import": "./dist/electron/preferences/index.js",
      "default": "./dist/electron/preferences/index.js"
    },
    "./node-toolchain": {
      "types": "./dist/node-toolchain/index.d.ts",
      "import": "./dist/node-toolchain/index.js",
      "default": "./dist/node-toolchain/index.js"
    },
    "./electron/usability": {
      "types": "./dist/electron/usability/index.d.ts",
      "import": "./dist/electron/usability/index.js",
      "default": "./dist/electron/usability/index.js"
    },
    "./speech": {
      "types": "./dist/speech/index.d.ts",
      "import": "./dist/speech/index.js",
      "default": "./dist/speech/index.js"
    },
    "./speech/macos": {
      "types": "./dist/speech/macos/index.d.ts",
      "import": "./dist/speech/macos/index.js",
      "default": "./dist/speech/macos/index.js"
    },
    "./speech/macos/speech-helper.swift": "./dist/speech/macos/speech-helper.swift",
    "./shell/find-in-page-verify": {
      "types": "./dist/shell/find-in-page-verify.d.ts",
      "import": "./dist/shell/find-in-page-verify.js",
      "default": "./dist/shell/find-in-page-verify.js"
    },
    "./shell/js-backslide-guard": {
      "types": "./dist/shell/js-backslide-guard.d.ts",
      "import": "./dist/shell/js-backslide-guard.js",
      "default": "./dist/shell/js-backslide-guard.js"
    },
    "./shell/pty-helpers": {
      "types": "./dist/shell/pty-helpers.d.ts",
      "import": "./dist/shell/pty-helpers.js",
      "default": "./dist/shell/pty-helpers.js"
    },
    "./shell/instance-presence": {
      "types": "./dist/shell/instance-presence.d.ts",
      "import": "./dist/shell/instance-presence.js",
      "default": "./dist/shell/instance-presence.js"
    },
    "./shell/auto-update-controller": {
      "types": "./dist/shell/auto-update-controller.d.ts",
      "import": "./dist/shell/auto-update-controller.js",
      "default": "./dist/shell/auto-update-controller.js"
    },
    "./shell/spellcheck-menu": {
      "types": "./dist/shell/spellcheck-menu.d.ts",
      "import": "./dist/shell/spellcheck-menu.js",
      "default": "./dist/shell/spellcheck-menu.js"
    },
    "./electron/selftest": {
      "types": "./dist/electron/selftest/index.d.ts",
      "import": "./dist/electron/selftest/index.js",
      "default": "./dist/electron/selftest/index.js"
    },
    "./shell/guest-navigation": {
      "types": "./dist/shell/guest-navigation.d.ts",
      "import": "./dist/shell/guest-navigation.js",
      "default": "./dist/shell/guest-navigation.js"
    },
    "./shell/site-presence": {
      "types": "./dist/shell/site-presence.d.ts",
      "import": "./dist/shell/site-presence.js",
      "default": "./dist/shell/site-presence.js"
    },
    "./electron/handoff": {
      "types": "./dist/electron/handoff/index.d.ts",
      "import": "./dist/electron/handoff/index.js",
      "default": "./dist/electron/handoff/index.js"
    },
    "./electron/preload": {
      "types": "./dist/electron/preload/index.d.ts",
      "import": "./dist/electron/preload/index.js",
      "default": "./dist/electron/preload/index.js"
    },
    "./electron/webview": {
      "types": "./dist/electron/webview/index.d.ts",
      "import": "./dist/electron/webview/index.js",
      "default": "./dist/electron/webview/index.js"
    },
    "./electron/session-bootstrap": {
      "types": "./dist/electron/session-bootstrap/index.d.ts",
      "import": "./dist/electron/session-bootstrap/index.js",
      "default": "./dist/electron/session-bootstrap/index.js"
    }
,
    "./electron/windows": {
      "types": "./dist/electron/windows/index.d.ts",
      "import": "./dist/electron/windows/index.js",
      "default": "./dist/electron/windows/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/speech/macos/speech-helper.swift dist/speech/macos/speech-helper.swift",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "@jini-ai/core": "workspace:^"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {}
}
