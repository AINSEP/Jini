{
  "name": "@jini-ai/analytics",
  "version": "0.7.3-next.2",
  "description": "Framework-free visitor analytics ingestion, aggregation and storage contracts for marketing applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/analytics"
  },
  "jini": {
    "domain": "capability",
    "kind": "analytics",
    "runtime": "node",
    "entries": {
      ".": "node",
      "./product": "universal",
      "./site/agent-tools": "universal",
      "./site/ports": "universal",
      "./site/contracts": "universal",
      "./site/forwarding": "universal",
      "./site/jini-adapters": "universal",
      "./site/salt": "node",
      "./site/tool-registrations": "universal",
      "./site/config.settings": "universal",
      "./admin-http/routes/recent-hits": "universal",
      "./public-http/routes/analytics-ingest": "universal"
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./product": {
      "types": "./dist/product/index.d.ts",
      "import": "./dist/product/index.js",
      "default": "./dist/product/index.js"
    },
    "./site/agent-tools": {
      "types": "./dist/site/agent-tools.d.ts",
      "import": "./dist/site/agent-tools.js",
      "default": "./dist/site/agent-tools.js"
    },
    "./site/ports": {
      "types": "./dist/site/ports.d.ts",
      "import": "./dist/site/ports.js",
      "default": "./dist/site/ports.js"
    },
    "./site/contracts": {
      "types": "./dist/site/contracts.d.ts",
      "import": "./dist/site/contracts.js",
      "default": "./dist/site/contracts.js"
    },
    "./site/forwarding": {
      "types": "./dist/site/forwarding.d.ts",
      "import": "./dist/site/forwarding.js",
      "default": "./dist/site/forwarding.js"
    },
    "./site/jini-adapters": {
      "types": "./dist/site/jini-adapters.d.ts",
      "import": "./dist/site/jini-adapters.js",
      "default": "./dist/site/jini-adapters.js"
    },
    "./site/salt": {
      "types": "./dist/site/salt.d.ts",
      "import": "./dist/site/salt.js",
      "default": "./dist/site/salt.js"
    },
    "./site/tool-registrations": {
      "types": "./dist/site/tool-registrations.d.ts",
      "import": "./dist/site/tool-registrations.js",
      "default": "./dist/site/tool-registrations.js"
    },
    "./site/config.settings": {
      "types": "./dist/site/config.settings.d.ts",
      "import": "./dist/site/config.settings.js",
      "default": "./dist/site/config.settings.js"
    },
    "./admin-http/routes/recent-hits": {
      "types": "./dist/admin-http/routes/recent-hits.d.ts",
      "import": "./dist/admin-http/routes/recent-hits.js",
      "default": "./dist/admin-http/routes/recent-hits.js"
    },
    "./public-http/routes/analytics-ingest": {
      "types": "./dist/public-http/routes/analytics-ingest.d.ts",
      "import": "./dist/public-http/routes/analytics-ingest.js",
      "default": "./dist/public-http/routes/analytics-ingest.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
