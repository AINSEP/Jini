{
  "name": "@jini-ai/devops",
  "version": "0.5.2",
  "description": "DevOps capabilities for deployment, source control, and CI/CD, exposed through independent subpaths.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/devops"
  },
  "jini": {
    "domain": "capability",
    "kind": "devops",
    "runtime": "node",
    "entries": {
      ".": "node",
      "./source-control": "node",
      "./static-export": "node",
      "./static-export/node": "node",
      "./packaging/electron": "node",
      "./packaging/electron/typescript": "node",
      "./agent-jobs": "node",
      "./deploy": "node",
      "./checks/published-types": "node",
      "./checks/coverage": "node",
      "./checks/node": "node",
      "./local-dev": "node",
      "./deploy/node": "node",
      "./static-export/failure-summary": "universal"
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./source-control": {
      "types": "./dist/source-control/entry.d.ts",
      "import": "./dist/source-control/entry.js",
      "default": "./dist/source-control/entry.js"
    },
    "./static-export": {
      "types": "./dist/static-export/entry.d.ts",
      "import": "./dist/static-export/entry.js",
      "default": "./dist/static-export/entry.js"
    },
    "./static-export/node": {
      "types": "./dist/static-export/node-adapters.d.ts",
      "import": "./dist/static-export/node-adapters.js",
      "default": "./dist/static-export/node-adapters.js"
    },
    "./packaging/electron": {
      "types": "./dist/packaging/electron/entry.d.ts",
      "import": "./dist/packaging/electron/entry.js",
      "default": "./dist/packaging/electron/entry.js"
    },
    "./packaging/electron/typescript": {
      "types": "./dist/packaging/electron/typescript.d.ts",
      "import": "./dist/packaging/electron/typescript.js",
      "default": "./dist/packaging/electron/typescript.js"
    },
    "./agent-jobs": {
      "types": "./dist/agent-jobs/entry.d.ts",
      "import": "./dist/agent-jobs/entry.js",
      "default": "./dist/agent-jobs/entry.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "import": "./dist/deploy/index.js",
      "default": "./dist/deploy/index.js"
    },
    "./checks/published-types": {
      "types": "./dist/checks/published-types/index.d.ts",
      "import": "./dist/checks/published-types/index.js",
      "default": "./dist/checks/published-types/index.js"
    },
    "./checks/coverage": {
      "types": "./dist/checks/coverage/index.d.ts",
      "import": "./dist/checks/coverage/index.js",
      "default": "./dist/checks/coverage/index.js"
    },
    "./checks/node": {
      "types": "./dist/checks/node.d.ts",
      "import": "./dist/checks/node.js",
      "default": "./dist/checks/node.js"
    },
    "./local-dev": {
      "types": "./dist/local-dev/index.d.ts",
      "import": "./dist/local-dev/index.js",
      "default": "./dist/local-dev/index.js"
    },
    "./deploy/node": {
      "types": "./dist/deploy/node.d.ts",
      "import": "./dist/deploy/node.js",
      "default": "./dist/deploy/node.js"
    },
    "./static-export/failure-summary": {
      "types": "./dist/core/export-failure-summary.d.ts",
      "import": "./dist/core/export-failure-summary.js",
      "default": "./dist/core/export-failure-summary.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@jini-ai/daemon": "workspace:*",
    "@vitest/coverage-v8": "^2.1.9",
    "@jini-ai/core": "workspace:^",
    "@jini-ai/platform": "workspace:^",
    "undici": "^7.25.0"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "typescript": "^5.6.0",
    "@jini-ai/platform": "^0.5.1",
    "undici": "^7.25.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "@jini-ai/platform": {
      "optional": true
    },
    "undici": {
      "optional": true
    }
  }
}
