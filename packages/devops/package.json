{
  "name": "@jini-ai/devops",
  "version": "0.7.3-next.2",
  "description": "DevOps capabilities for deployment, source control, and CI/CD, exposed through independent subpaths.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/devops"
  },
  "jini": {
    "domain": "capability",
    "kind": "devops",
    "runtime": "node",
    "entries": {
      ".": "node",
      "./source-control": "node",
      "./static-export": "node",
      "./static-export/node": "node",
      "./packaging/electron": "node",
      "./packaging/electron/typescript": "node",
      "./agent-jobs": "node",
      "./deploy": "node",
      "./deploy/react": "browser",
      "./checks/published-types": "node",
      "./checks/coverage": "node",
      "./checks/node": "node",
      "./checks/memory-soak": "universal",
      "./checks/env-access": "universal",
      "./local-dev": "node",
      "./deploy/node": "node",
      "./static-export/failure-summary": "universal",
      "./dns": "node",
      "./dns/node": "node",
      "./backup/upload": "node",
      "./backup/plan-store": "node",
      "./backup/push-jobs": "universal",
      "./static-export/site/ports": "universal",
      "./static-export/site/public-origin-policy": "universal",
      "./checks/quality-gates": "universal",
      "./checks/complexity-debt": "universal",
      "./checks/live-verify-checks": "universal"
    },
    "isolation": {
      "shared": [
        "src/core/export-failure-summary.ts"
      ]
    },
    "optionalPeers": {
      "parse5": "opt-in: html parsing; import @jini-ai/devops/static-export — HTML parsing could not load parse5. Install parse5 to enable this feature, or check its installed version and native binaries.",
      "typescript": "opt-in: typescript source analysis — TypeScript source analysis could not load typescript. Install typescript to enable this feature, or check its installed version and native binaries.",
      "undici": "opt-in: custom http dispatchers; import @jini-ai/devops/deploy/node — Custom HTTP dispatchers could not load undici. Install undici to enable this feature, or check its installed version and native binaries.",
      "electron": "opt-in: desktop runtime selection; import @jini-ai/devops/local-dev — Desktop runtime selection could not load electron. Install electron to run the dev server on Electron-as-node, or use stock Node.",
      "react": "opt-in: react publish result view; import @jini-ai/devops/deploy/react — The publish result view could not load react. Install react to enable this feature, or check its installed version."
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./source-control": {
      "types": "./dist/source-control/entry.d.ts",
      "import": "./dist/source-control/entry.js",
      "default": "./dist/source-control/entry.js"
    },
    "./static-export": {
      "types": "./dist/static-export/entry.d.ts",
      "import": "./dist/static-export/entry.js",
      "default": "./dist/static-export/entry.js"
    },
    "./static-export/node": {
      "types": "./dist/static-export/node-adapters.d.ts",
      "import": "./dist/static-export/node-adapters.js",
      "default": "./dist/static-export/node-adapters.js"
    },
    "./packaging/electron": {
      "types": "./dist/packaging/electron/entry.d.ts",
      "import": "./dist/packaging/electron/entry.js",
      "default": "./dist/packaging/electron/entry.js"
    },
    "./packaging/electron/typescript": {
      "types": "./dist/packaging/electron/typescript.d.ts",
      "import": "./dist/packaging/electron/typescript.js",
      "default": "./dist/packaging/electron/typescript.js"
    },
    "./agent-jobs": {
      "types": "./dist/agent-jobs/entry.d.ts",
      "import": "./dist/agent-jobs/entry.js",
      "default": "./dist/agent-jobs/entry.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "import": "./dist/deploy/index.js",
      "default": "./dist/deploy/index.js"
    },
    "./deploy/react": {
      "types": "./dist/deploy/react/index.d.ts",
      "import": "./dist/deploy/react/index.js",
      "default": "./dist/deploy/react/index.js"
    },
    "./checks/published-types": {
      "types": "./dist/checks/published-types/index.d.ts",
      "import": "./dist/checks/published-types/index.js",
      "default": "./dist/checks/published-types/index.js"
    },
    "./checks/coverage": {
      "types": "./dist/checks/coverage/index.d.ts",
      "import": "./dist/checks/coverage/index.js",
      "default": "./dist/checks/coverage/index.js"
    },
    "./checks/node": {
      "types": "./dist/checks/node.d.ts",
      "import": "./dist/checks/node.js",
      "default": "./dist/checks/node.js"
    },
    "./checks/memory-soak": {
      "types": "./dist/checks/memory-soak.d.ts",
      "import": "./dist/checks/memory-soak.js",
      "default": "./dist/checks/memory-soak.js"
    },
    "./checks/env-access": {
      "types": "./dist/checks/env-access.d.ts",
      "import": "./dist/checks/env-access.js",
      "default": "./dist/checks/env-access.js"
    },
    "./local-dev": {
      "types": "./dist/local-dev/index.d.ts",
      "import": "./dist/local-dev/index.js",
      "default": "./dist/local-dev/index.js"
    },
    "./deploy/node": {
      "types": "./dist/deploy/node.d.ts",
      "import": "./dist/deploy/node.js",
      "default": "./dist/deploy/node.js"
    },
    "./static-export/failure-summary": {
      "types": "./dist/core/export-failure-summary.d.ts",
      "import": "./dist/core/export-failure-summary.js",
      "default": "./dist/core/export-failure-summary.js"
    },
    "./dns": {
      "types": "./dist/dns/index.d.ts",
      "import": "./dist/dns/index.js",
      "default": "./dist/dns/index.js"
    },
    "./dns/node": {
      "types": "./dist/dns/node/index.d.ts",
      "import": "./dist/dns/node/index.js",
      "default": "./dist/dns/node/index.js"
    },
    "./backup/upload": {
      "types": "./dist/backup/upload.node.d.ts",
      "import": "./dist/backup/upload.node.js",
      "default": "./dist/backup/upload.node.js"
    },
    "./backup/plan-store": {
      "types": "./dist/backup/plan-store.node.d.ts",
      "import": "./dist/backup/plan-store.node.js",
      "default": "./dist/backup/plan-store.node.js"
    },
    "./backup/push-jobs": {
      "types": "./dist/backup/push-jobs.d.ts",
      "import": "./dist/backup/push-jobs.js",
      "default": "./dist/backup/push-jobs.js"
    },
    "./static-export/site/ports": {
      "types": "./dist/static-export/site/ports.d.ts",
      "import": "./dist/static-export/site/ports.js",
      "default": "./dist/static-export/site/ports.js"
    },
    "./static-export/site/public-origin-policy": {
      "types": "./dist/static-export/site/public-origin-policy.d.ts",
      "import": "./dist/static-export/site/public-origin-policy.js",
      "default": "./dist/static-export/site/public-origin-policy.js"
    },
    "./checks/quality-gates": {
      "types": "./dist/checks/quality-gates.d.ts",
      "import": "./dist/checks/quality-gates.js",
      "default": "./dist/checks/quality-gates.js"
    },
    "./checks/complexity-debt": {
      "types": "./dist/checks/complexity-debt.d.ts",
      "import": "./dist/checks/complexity-debt.js",
      "default": "./dist/checks/complexity-debt.js"
    },
    "./checks/live-verify-checks": {
      "types": "./dist/checks/live-verify-checks.d.ts",
      "import": "./dist/checks/live-verify-checks.js",
      "default": "./dist/checks/live-verify-checks.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@jini-ai/core": "workspace:^",
    "@jini-ai/daemon": "workspace:*",
    "@jini-ai/platform": "workspace:^",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^3.2.6",
    "parse5": "7.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.30.1"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "typescript": "^5.6.0",
    "undici": "^7.25.0",
    "parse5": "7.3.0",
    "electron": ">=30.0.0",
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "parse5": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "undici": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
