{
  "name": "@jini-ai/charts-recharts",
  "version": "0.1.0",
  "private": true,
  "description": "Private build workspace for the reviewed standalone Recharts browser-provider artifact.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/charts-recharts"
  },
  "jini": {
    "domain": "ui",
    "kind": "react-library",
    "runtime": "browser",
    "entries": {
      ".": "browser",
      "./styles.css": "browser"
    }
  },
  "type": "module",
  "sideEffects": [
    "./plugin/client/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./plugin/client/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-artifact.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@jini-ai/ui": "workspace:^",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^25.0.1",
    "esbuild": "^0.28.1"
  }
}
