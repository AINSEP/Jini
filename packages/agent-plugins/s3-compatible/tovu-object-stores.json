{
  "schemaVersion": 1,
  "providers": [
    {
      "id": "s3_compatible",
      "label": "S3-compatible storage",
      "module": "object-stores/s3-compatible.mjs",
      "env": {
        "selector": "s3",
        "settings": {
          "bucket": "TOVU_S3_BUCKET",
          "keyPrefix": "TOVU_S3_KEY_PREFIX"
        },
        "credentialFields": {
          "accessKeyId": "TOVU_S3_ACCESS_KEY_ID",
          "region": "TOVU_S3_REGION",
          "endpoint": "TOVU_S3_ENDPOINT"
        },
        "secret": "TOVU_S3_SECRET_ACCESS_KEY",
        "required": [
          "TOVU_S3_BUCKET",
          "TOVU_S3_REGION",
          "TOVU_S3_ACCESS_KEY_ID",
          "TOVU_S3_SECRET_ACCESS_KEY"
        ]
      }
    }
  ]
}
