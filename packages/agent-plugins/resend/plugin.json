{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "resend",
  "version": "0.2.1",
  "description": "Sends the site's email (sign-in links, form notifications, newsletters) through Resend's hosted email API, and connects the assistant to Resend's own hosted MCP server for work on the Resend account itself: domains and their DNS verification, broadcasts, contacts, segments, topics, templates, logs and usage. Ships the mail adapter (a host loads it only when the host shipped it) and the know-how to set both up: a sending key saved through credential_save for site mail, and a separate Full access key saved through the secure account card for the account tools.",
  "author": "Tovu",
  "license": "Apache-2.0",
  "extensions": {
    "tovu": {
      "vendorAliases": ["resend.com", "HttpApiMailerAdapter"],
      "summary": "Sends your site's emails through Resend, and lets the assistant manage your Resend account: domains, broadcasts and contacts.",
      "id": "tovu/resend",
      "provides": [
        "outbound-mail"
      ],
      "mcpServers": {
        "resend": {
          "tovuAuthMode": "none",
          "tovuDefaultTools": {
            "allow": [
              "list-domains",
              "get-domain",
              "get-domain-claim",
              "list-emails",
              "get-email",
              "get-email-metrics",
              "list-received-emails",
              "get-received-email",
              "list-received-email-attachments",
              "get-received-email-attachment",
              "list-broadcasts",
              "get-broadcast",
              "list-broadcast-recipients",
              "list-broadcast-clicked-links",
              "list-contacts",
              "get-contact",
              "list-contact-segments",
              "list-contact-topics",
              "list-segments",
              "get-segment",
              "list-topics",
              "get-topic",
              "list-contact-properties",
              "get-contact-property",
              "list-templates",
              "get-template",
              "list-webhooks",
              "get-webhook",
              "list-webhook-events",
              "get-webhook-event",
              "list-webhook-event-attempts",
              "list-api-keys",
              "list-logs",
              "get-log",
              "get-usage",
              "list-suppressions",
              "get-suppression",
              "create-domain",
              "update-domain",
              "verify-domain",
              "create-domain-claim",
              "verify-domain-claim",
              "send-email",
              "send-batch-emails",
              "cancel-email",
              "update-email",
              "create-broadcast",
              "update-broadcast",
              "compose-broadcast",
              "cancel-broadcast",
              "create-contact",
              "update-contact",
              "add-contact-to-segment",
              "update-contact-topics",
              "create-segment",
              "update-segment",
              "create-topic",
              "update-topic",
              "create-template",
              "update-template",
              "compose-template",
              "publish-template"
            ],
            "write": [
              "create-domain",
              "update-domain",
              "verify-domain",
              "create-domain-claim",
              "verify-domain-claim",
              "send-email",
              "send-batch-emails",
              "cancel-email",
              "update-email",
              "create-broadcast",
              "update-broadcast",
              "compose-broadcast",
              "cancel-broadcast",
              "create-contact",
              "update-contact",
              "add-contact-to-segment",
              "update-contact-topics",
              "create-segment",
              "update-segment",
              "create-topic",
              "update-topic",
              "create-template",
              "update-template",
              "compose-template",
              "publish-template"
            ],
            "read": [
              "list-domains",
              "get-domain",
              "get-domain-claim",
              "list-emails",
              "get-email",
              "get-email-metrics",
              "list-received-emails",
              "get-received-email",
              "list-received-email-attachments",
              "get-received-email-attachment",
              "list-broadcasts",
              "get-broadcast",
              "list-broadcast-recipients",
              "list-broadcast-clicked-links",
              "list-contacts",
              "get-contact",
              "list-contact-segments",
              "list-contact-topics",
              "list-segments",
              "get-segment",
              "list-topics",
              "get-topic",
              "list-contact-properties",
              "get-contact-property",
              "list-templates",
              "get-template",
              "list-webhooks",
              "get-webhook",
              "list-webhook-events",
              "get-webhook-event",
              "list-webhook-event-attempts",
              "list-api-keys",
              "list-logs",
              "get-log",
              "get-usage",
              "list-suppressions",
              "get-suppression"
            ]
          }
        }
      },
      "credentialCards": [
        {
          "target": "resend-mcp",
          "title": "Connect Resend with a Full access key",
          "label": "Resend account",
          "category": "ops",
          "intro": "Let the assistant add and verify your email domain in Resend. This saves a separate account key and keeps your site's sending key.",
          "usedFor": [
            "Adds and verifies your email domain",
            "Manages contacts and broadcasts",
            "Manages email templates and reads email activity and account usage",
            "Sends one-off emails you request"
          ],
          "keyHint": "In Resend, open API Keys → Create API Key. Choose Full access and all domains. Sending access cannot add or verify domains.",
          "saveKind": "agent-plugin-token",
          "saveTarget": "resend",
          "helpUrl": "https://resend.com/api-keys",
          "helpLabel": "Create a Full access key in Resend",
          "baseUrl": "https://api.resend.com"
        }
      ]
    }
  },
  "keywords": [
    "resend",
    "email",
    "mail",
    "send-email",
    "transactional-email",
    "newsletter",
    "smtp-alternative",
    "outbound-mail",
    "domains",
    "dns",
    "broadcast",
    "contacts",
    "audience",
    "mcp"
  ]
}
