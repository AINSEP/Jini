{
  "name": "@jini-ai/agent-plugins",
  "version": "0.6.24",
  "description": "Support for Agent Plugins: vendor-neutral manifest types and validators, installation, activation, digests and trusted contribution loading. Every Jini agent plugin ships here as its own subpath (@jini-ai/agent-plugins/<id>); resolving one never loads another plugin's files.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/agent-plugins"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      ".": "universal",
      "./lifecycle": "node",
      "./lifecycle/node": "node",
      "./lifecycle/yauzl": "node",
      "./lifecycle/tools": "node",
      "./lifecycle/host-tools": "node",
      "./lifecycle/mail": "node",
      "./manifest": "universal",
      "./persistent-state": "node",
      "./folder-zip": "universal",
      "./folder-zip/node": "node",
      "./admin-surfaces": "universal",
      "./admin-surfaces/client": "universal",
      "./charts-echarts": "universal",
      "./charts-echarts/*": "universal",
      "./charts-recharts": "universal",
      "./charts-recharts/*": "universal",
      "./cloudflare": "universal",
      "./cloudflare/*": "universal",
      "./composio": "universal",
      "./composio/*": "universal",
      "./fly": "universal",
      "./fly/*": "universal",
      "./github": "universal",
      "./github/*": "universal",
      "./github-pages": "universal",
      "./github-pages/*": "universal",
      "./google-login": "universal",
      "./google-login/*": "universal",
      "./google-workspace": "universal",
      "./google-workspace/*": "universal",
      "./higgsfield-media": "universal",
      "./higgsfield-media/*": "universal",
      "./jev": "universal",
      "./jev/*": "universal",
      "./meilisearch": "universal",
      "./meilisearch/*": "universal",
      "./netlify": "universal",
      "./netlify/*": "universal",
      "./opentelemetry": "universal",
      "./opentelemetry/*": "universal",
      "./posthog": "universal",
      "./posthog/*": "universal",
      "./railway": "universal",
      "./railway/*": "universal",
      "./render": "universal",
      "./render/*": "universal",
      "./resend": "universal",
      "./resend/*": "universal",
      "./s3-compatible": "universal",
      "./s3-compatible/*": "universal",
      "./sentry": "universal",
      "./sentry/*": "universal",
      "./shopify": "universal",
      "./shopify/*": "universal",
      "./site-compliance": "universal",
      "./site-compliance/*": "universal",
      "./site-import": "universal",
      "./site-import/*": "universal",
      "./slide-design": "universal",
      "./slide-design/*": "universal",
      "./supabase": "universal",
      "./supabase/*": "universal",
      "./ui-ux-design": "universal",
      "./ui-ux-design/*": "universal",
      "./vercel": "universal",
      "./vercel/*": "universal",
      "./wordpress": "universal",
      "./wordpress/*": "universal",
      "./langfuse": "universal",
      "./langfuse/*": "universal",
      "./stripe": "universal",
      "./stripe/*": "universal",
      "./formspree": "universal",
      "./formspree/*": "universal",
      "./software-engineering": "universal",
      "./software-engineering/*": "universal",
      "./commerce": "universal",
      "./commerce/*": "universal",
      "./commerce/server": "node",
      "./google-forms": "universal",
      "./google-forms/*": "universal",
      "./connect": "universal"
    },
    "isolation": {
      "entries": {
        "./manifest": "lifecycle",
        "./persistent-state": "core",
        "./connect": "lifecycle"
      },
      "shared": [
        "core/persistent-state.js",
        "persistent-state.js",
        "src/lifecycle/contribution-loader.ts",
        "src/lifecycle/tools/capabilities.ts"
      ]
    },
    "optionalPeers": {
      "yauzl": "opt-in: plugin zip import \u2014 Plugin ZIP import could not load yauzl. Install yauzl to enable this feature, or check its installed version and native binaries.",
      "@jini-ai/platform": "opt-in: platform-backed adapters; import @jini-ai/agent-plugins/lifecycle \u2014 Platform-backed adapters could not load @jini-ai/platform. Install @jini-ai/platform to enable this feature, or check its installed version and native binaries.",
      "@cfworker/json-schema": "opt-in: json schema validation; import @jini-ai/agent-plugins/lifecycle/tools \u2014 JSON Schema validation could not load @cfworker/json-schema. Install @cfworker/json-schema to enable this feature, or check its installed version and native binaries.",
      "semver": "opt-in: plugin version compatibility; import @jini-ai/agent-plugins/lifecycle \u2014 Plugin version compatibility could not load semver. Install semver to enable this feature, or check its installed version and native binaries.",
      "@jini-ai/commerce": "opt-in: commerce server; import @jini-ai/agent-plugins/commerce/server \u2014 Commerce checkout requires the host commerce kernel."
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "import": "./dist/lifecycle/index.js",
      "default": "./dist/lifecycle/index.js"
    },
    "./lifecycle/node": {
      "types": "./dist/lifecycle/node.d.ts",
      "import": "./dist/lifecycle/node.js",
      "default": "./dist/lifecycle/node.js"
    },
    "./lifecycle/yauzl": {
      "types": "./dist/lifecycle/yauzl-archive-reader.d.ts",
      "import": "./dist/lifecycle/yauzl-archive-reader.js",
      "default": "./dist/lifecycle/yauzl-archive-reader.js"
    },
    "./lifecycle/tools": {
      "types": "./dist/lifecycle/tools/index.d.ts",
      "import": "./dist/lifecycle/tools/index.js",
      "default": "./dist/lifecycle/tools/index.js"
    },
    "./lifecycle/host-tools": {
      "types": "./dist/lifecycle/host-tools/index.d.ts",
      "import": "./dist/lifecycle/host-tools/index.js",
      "default": "./dist/lifecycle/host-tools/index.js"
    },
    "./lifecycle/mail": {
      "types": "./dist/lifecycle/mail/index.d.ts",
      "import": "./dist/lifecycle/mail/index.js",
      "default": "./dist/lifecycle/mail/index.js"
    },
    "./manifest": {
      "types": "./dist/lifecycle/manifest.d.ts",
      "import": "./dist/lifecycle/manifest.js",
      "default": "./dist/lifecycle/manifest.js"
    },
    "./persistent-state": {
      "types": "./persistent-state.d.ts",
      "import": "./persistent-state.js",
      "default": "./persistent-state.js"
    },
    "./folder-zip": {
      "types": "./dist/folder-zip.d.ts",
      "import": "./dist/folder-zip.js",
      "default": "./dist/folder-zip.js"
    },
    "./folder-zip/node": {
      "types": "./dist/folder-zip-node.d.ts",
      "import": "./dist/folder-zip-node.js",
      "default": "./dist/folder-zip-node.js"
    },
    "./admin-surfaces": {
      "types": "./dist/admin-surfaces/index.d.ts",
      "import": "./dist/admin-surfaces/index.js",
      "default": "./dist/admin-surfaces/index.js"
    },
    "./admin-surfaces/client": {
      "types": "./dist/admin-surfaces/surface-client.d.ts",
      "import": "./dist/admin-surfaces/surface-client.js",
      "default": "./dist/admin-surfaces/surface-client.js"
    },
    "./charts-echarts": "./charts-echarts/plugin.json",
    "./charts-echarts/*": "./charts-echarts/*",
    "./charts-recharts": "./charts-recharts/plugin.json",
    "./charts-recharts/*": "./charts-recharts/*",
    "./cloudflare": "./cloudflare/plugin.json",
    "./cloudflare/*": "./cloudflare/*",
    "./composio": "./composio/plugin.json",
    "./composio/*": "./composio/*",
    "./fly": "./fly/plugin.json",
    "./fly/*": "./fly/*",
    "./github": "./github/plugin.json",
    "./github/*": "./github/*",
    "./github-pages": "./github-pages/plugin.json",
    "./github-pages/*": "./github-pages/*",
    "./google-login": "./google-login/plugin.json",
    "./google-login/*": "./google-login/*",
    "./google-workspace": "./google-workspace/plugin.json",
    "./google-workspace/*": "./google-workspace/*",
    "./higgsfield-media": "./higgsfield-media/plugin.json",
    "./higgsfield-media/*": "./higgsfield-media/*",
    "./jev": "./jev/plugin.json",
    "./jev/*": "./jev/*",
    "./meilisearch": "./meilisearch/plugin.json",
    "./meilisearch/*": "./meilisearch/*",
    "./netlify": "./netlify/plugin.json",
    "./netlify/*": "./netlify/*",
    "./opentelemetry": "./opentelemetry/plugin.json",
    "./opentelemetry/*": "./opentelemetry/*",
    "./posthog": "./posthog/plugin.json",
    "./posthog/*": "./posthog/*",
    "./railway": "./railway/plugin.json",
    "./railway/*": "./railway/*",
    "./render": "./render/plugin.json",
    "./render/*": "./render/*",
    "./resend": "./resend/plugin.json",
    "./resend/*": "./resend/*",
    "./s3-compatible": "./s3-compatible/plugin.json",
    "./s3-compatible/*": "./s3-compatible/*",
    "./sentry": "./sentry/plugin.json",
    "./sentry/*": "./sentry/*",
    "./shopify": "./shopify/plugin.json",
    "./shopify/*": "./shopify/*",
    "./site-compliance": "./site-compliance/plugin.json",
    "./site-compliance/*": "./site-compliance/*",
    "./site-import": "./site-import/plugin.json",
    "./site-import/*": "./site-import/*",
    "./slide-design": "./slide-design/plugin.json",
    "./slide-design/*": "./slide-design/*",
    "./supabase": "./supabase/plugin.json",
    "./supabase/*": "./supabase/*",
    "./ui-ux-design": "./ui-ux-design/plugin.json",
    "./ui-ux-design/*": "./ui-ux-design/*",
    "./vercel": "./vercel/plugin.json",
    "./vercel/*": "./vercel/*",
    "./wordpress": "./wordpress/plugin.json",
    "./wordpress/*": "./wordpress/*",
    "./langfuse": "./langfuse/plugin.json",
    "./langfuse/*": "./langfuse/*",
    "./stripe": "./stripe/plugin.json",
    "./stripe/*": "./stripe/*",
    "./formspree": "./formspree/plugin.json",
    "./formspree/*": "./formspree/*",
    "./software-engineering": "./software-engineering/plugin.json",
    "./software-engineering/*": "./software-engineering/*",
    "./commerce": "./commerce/plugin.json",
    "./commerce/server": {
      "types": "./core/commerce-server.d.ts",
      "import": "./core/commerce-server.mjs",
      "default": "./core/commerce-server.mjs"
    },
    "./commerce/*": "./commerce/*",
    "./google-forms": "./google-forms/plugin.json",
    "./google-forms/*": "./google-forms/*",
    "./connect": {
      "types": "./dist/connect/index.d.ts",
      "import": "./dist/connect/index.js",
      "default": "./dist/connect/index.js"
    }
  },
  "files": [
    "formspree",
    "google-forms",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "persistent-state.js",
    "persistent-state.d.ts",
    "core",
    "charts-echarts",
    "charts-recharts",
    "cloudflare",
    "composio",
    "fly",
    "github",
    "github-pages",
    "google-login",
    "google-workspace",
    "higgsfield-media",
    "jev",
    "meilisearch",
    "netlify",
    "opentelemetry",
    "posthog",
    "railway",
    "render",
    "resend",
    "s3-compatible",
    "sentry",
    "shopify",
    "site-compliance",
    "site-import",
    "slide-design",
    "software-engineering",
    "supabase",
    "ui-ux-design",
    "vercel",
    "wordpress",
    "langfuse",
    "stripe",
    "commerce",
    "!**/__tests__/**"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-cloudflare.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "yazl": "^3.3.1",
    "@jini-ai/core": "^0.6.13",
    "@jini-ai/platform": "^0.6.13",
    "@cfworker/json-schema": "^4.1.1",
    "@jini-ai/cms": "workspace:^",
    "@jini-ai/plugins": "workspace:^",
    "@types/semver": "^7.5.8",
    "semver": "^7.6.2",
    "@jini-ai/oauth": "workspace:^",
    "fast-check": "4.3.0",
    "jsdom": "^25.0.1",
    "esbuild": "^0.28.1"
  },
  "peerDependencies": {
    "yauzl": "^3.4.0",
    "@jini-ai/core": "^0.6.10",
    "@jini-ai/platform": "^0.6.10",
    "@cfworker/json-schema": "^4.1.1",
    "semver": "^7.6.2",
    "@jini-ai/commerce": "^0.6.19"
  },
  "peerDependenciesMeta": {
    "yauzl": {
      "optional": true
    },
    "@jini-ai/platform": {
      "optional": true
    },
    "@cfworker/json-schema": {
      "optional": true
    },
    "semver": {
      "optional": true
    },
    "@jini-ai/commerce": {
      "optional": true
    }
  }
}
