{
  "name": "@jini-ai/agent-plugins",
  "version": "0.4.1",
  "description": "Support for Agent Plugins, the open, vendor-neutral spec (v1.0.0, published 2026-08-06, Technical Steering Committee with maintainers from Amazon, Cursor, Google, Microsoft, OpenAI, and Vercel) for bundling Agent Skills and MCP servers into one portable directory: PluginManifest/McpManifest types + structural validators on the package root, plus the bundled plugins themselves, each on a subpath named for itself (./ui-ux-design). Extracted 2026-08-18 from @jini-ai/plugins, which now only reserves the unrelated, unimplemented ./host format.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/agent-plugins"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      ".": "universal",
      "./ui-ux-design/*": "universal",
      "./lifecycle": "node",
      "./lifecycle/node": "node",
      "./lifecycle/yauzl": "node",
      "./manifest": "universal",
      "./persistent-state": "node"
    },
    "isolation": {
      "entries": {
        "./manifest": "lifecycle",
        "./persistent-state": "core"
      },
      "shared": [
        "core/persistent-state.js",
        "persistent-state.js"
      ]
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ui-ux-design/*": "./ui-ux-design/*",
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "import": "./dist/lifecycle/index.js",
      "default": "./dist/lifecycle/index.js"
    },
    "./lifecycle/node": {
      "types": "./dist/lifecycle/node.d.ts",
      "import": "./dist/lifecycle/node.js",
      "default": "./dist/lifecycle/node.js"
    },
    "./lifecycle/yauzl": {
      "types": "./dist/lifecycle/yauzl-archive-reader.d.ts",
      "import": "./dist/lifecycle/yauzl-archive-reader.js",
      "default": "./dist/lifecycle/yauzl-archive-reader.js"
    },
    "./manifest": {
      "types": "./dist/lifecycle/manifest.d.ts",
      "import": "./dist/lifecycle/manifest.js",
      "default": "./dist/lifecycle/manifest.js"
    },
    "./persistent-state": {
      "types": "./persistent-state.d.ts",
      "import": "./persistent-state.js",
      "default": "./persistent-state.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "ui-ux-design",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "persistent-state.js",
    "persistent-state.d.ts",
    "core"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "yazl": "^3.3.1",
    "@jini-ai/core": "^0.4.0",
    "@jini-ai/platform": "^0.5.0"
  },
  "peerDependencies": {
    "yauzl": "^3.4.0",
    "@jini-ai/core": "^0.4.0",
    "@jini-ai/platform": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "yauzl": {
      "optional": true
    },
    "@jini-ai/core": {
      "optional": true
    },
    "@jini-ai/platform": {
      "optional": true
    }
  }
}
