{
  "name": "@jini-ai/cookie-consent",
  "version": "0.7.3-next.2",
  "description": "Standalone, vendor-free cookie consent: a consent-state contract any banner can drive, a ~3 KB browser client, a pure-string banner renderer with owner CSS, web-standard receipts and open plugin slots.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/cookie-consent"
  },
  "jini": {
    "domain": "capability",
    "kind": "consent",
    "runtime": "universal",
    "isolation": {
      "entries": {
        "./client.min.js": "client",
        "./extensions.min.js": "client",
        "./site/cookie-consent": "render",
        "./site/validation": "render",
      "./site/service": "render",
      "./site/tool-registrations": "render"
      },
      "shared": [
        "src/site/config.ts",
        "src/site/validation.ts",
        "src/site/cookie-consent.ts",
        "src/render/css.ts",
        "src/server/region.ts",
        "src/site/revisions.ts",
        "src/site/readiness.ts"
      ]
    },
    "entries": {
      ".": "universal",
      "./policy": "universal",
      "./plugins": "universal",
      "./render": "universal",
      "./react": "browser",
      "./client": "browser",
      "./client.min.js": "browser",
      "./banner.css": "browser",
      "./server": "universal",
      "./node": "node",
      "./extensions.min.js": "browser",
      "./site/config": "universal",
      "./site/cookie-consent": "universal",
      "./site/validation": "universal",
      "./site/revisions": "universal",
      "./site/privacy-page-template": "universal",
      "./site/settings": "universal",
      "./site/readiness": "node",
      "./site/service": "node",
      "./site/region-plugins": "universal",
      "./site/ensure-privacy-defaults": "universal",
      "./site/tool-registrations": "node",
      "./site/request": "universal",
      "./site/revisions.repo": "node"
    },
    "optionalPeers": {
      "react": "opt-in: react consent settings; import @jini-ai/cookie-consent/react — React consent settings could not load react. Install react to enable this feature, or check its installed version.",
      "kysely": "opt-in: SQL consent revisions — Install kysely to use the site consent SQL store."
    }
  },
  "type": "module",
  "sideEffects": [
    "./dist/client.min.js",
    "./dist/extensions.min.js"
  ],
  "main": "./dist/contract.js",
  "types": "./dist/contract.d.ts",
  "exports": {
    ".": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js",
      "default": "./dist/policy.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js",
      "default": "./dist/plugins.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js",
      "default": "./dist/render/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./client.min.js": "./dist/client.min.js",
    "./banner.css": "./dist/banner.css",
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./extensions.min.js": "./dist/extensions.min.js",
    "./site/config": {
      "types": "./dist/site/config.d.ts",
      "import": "./dist/site/config.js",
      "default": "./dist/site/config.js"
    },
    "./site/cookie-consent": {
      "types": "./dist/site/cookie-consent.d.ts",
      "import": "./dist/site/cookie-consent.js",
      "default": "./dist/site/cookie-consent.js"
    },
    "./site/validation": {
      "types": "./dist/site/validation.d.ts",
      "import": "./dist/site/validation.js",
      "default": "./dist/site/validation.js"
    },
    "./site/revisions": {
      "types": "./dist/site/revisions.d.ts",
      "import": "./dist/site/revisions.js",
      "default": "./dist/site/revisions.js"
    },
    "./site/privacy-page-template": {
      "types": "./dist/site/privacy-page-template.d.ts",
      "import": "./dist/site/privacy-page-template.js",
      "default": "./dist/site/privacy-page-template.js"
    },
    "./site/settings": {
      "types": "./dist/site/settings.d.ts",
      "import": "./dist/site/settings.js",
      "default": "./dist/site/settings.js"
    },
    "./site/readiness": {
      "types": "./dist/site/readiness.d.ts",
      "import": "./dist/site/readiness.js",
      "default": "./dist/site/readiness.js"
    },
    "./site/service": {
      "types": "./dist/site/service.d.ts",
      "import": "./dist/site/service.js",
      "default": "./dist/site/service.js"
    },
    "./site/region-plugins": {
      "types": "./dist/site/region-plugins.d.ts",
      "import": "./dist/site/region-plugins.js",
      "default": "./dist/site/region-plugins.js"
    },
    "./site/ensure-privacy-defaults": {
      "types": "./dist/site/ensure-privacy-defaults.d.ts",
      "import": "./dist/site/ensure-privacy-defaults.js",
      "default": "./dist/site/ensure-privacy-defaults.js"
    },
    "./site/tool-registrations": {
      "types": "./dist/site/tool-registrations.d.ts",
      "import": "./dist/site/tool-registrations.js",
      "default": "./dist/site/tool-registrations.js"
    },
    "./site/request": {
      "types": "./dist/site/request.d.ts",
      "import": "./dist/site/request.js",
      "default": "./dist/site/request.js"
    },
    "./site/revisions.repo": {
      "types": "./dist/site/revisions.repo.d.ts",
      "import": "./dist/site/revisions.repo.js",
      "default": "./dist/site/revisions.repo.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/__tests__/**",
    "!dist/**/*.test.*",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.28.1",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "kysely": "^0.29.6"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "kysely": "^0.29.6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  }
}
