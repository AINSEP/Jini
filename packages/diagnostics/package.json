{
  "name": "@jini-ai/diagnostics",
  "version": "0.7.3-next.2",
  "description": "Diagnostics-bundle tooling: JSON/text secret redaction, log-source collection, manifest building, and zip packaging for support exports.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/diagnostics"
  },
  "jini": {
    "domain": "tooling",
    "kind": "diagnostics",
    "entries": {
      ".": "node",
      "./redaction/secrets-only": "universal",
      "./observability": "universal",
      "./observability/node": "node",
      "./web-evidence": "universal",
      "./web-evidence/playwright": "node",
      "./web-evidence/page-body": "node",
      "./web-evidence/site-path-policy": "universal",
      "./web-evidence/published-page": "node",
      "./web-evidence/testing": "universal",
      "./web-evidence/capture-budget": "universal",
      "./web-evidence/capture-clock": "universal",
      "./domain-dns": "node",
      "./local-text": "node",
      "./console-tee": "node"
    },
    "runtime": "node",
    "optionalPeers": {
      "parse5": "opt-in: page body projection; import @jini-ai/diagnostics/web-evidence/page-body — The page body projection could not load parse5. Install parse5@7.3.0 to enable this feature, or check its installed version."
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./redaction/secrets-only": {
      "types": "./dist/redaction/secrets-only.d.ts",
      "import": "./dist/redaction/secrets-only.js",
      "default": "./dist/redaction/secrets-only.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js",
      "default": "./dist/observability/index.js"
    },
    "./observability/node": {
      "types": "./dist/observability/node.d.ts",
      "import": "./dist/observability/node.js",
      "default": "./dist/observability/node.js"
    },
    "./web-evidence": {
      "types": "./dist/web-evidence/index.d.ts",
      "import": "./dist/web-evidence/index.js",
      "default": "./dist/web-evidence/index.js"
    },
    "./web-evidence/playwright": {
      "types": "./dist/web-evidence/playwright-browser.d.ts",
      "import": "./dist/web-evidence/playwright-browser.js",
      "default": "./dist/web-evidence/playwright-browser.js"
    },
    "./web-evidence/page-body": {
      "types": "./dist/web-evidence/page-body.d.ts",
      "import": "./dist/web-evidence/page-body.js",
      "default": "./dist/web-evidence/page-body.js"
    },
    "./web-evidence/site-path-policy": {
      "types": "./dist/web-evidence/site-path-policy.d.ts",
      "import": "./dist/web-evidence/site-path-policy.js",
      "default": "./dist/web-evidence/site-path-policy.js"
    },
    "./web-evidence/published-page": {
      "types": "./dist/web-evidence/published-page.d.ts",
      "import": "./dist/web-evidence/published-page.js",
      "default": "./dist/web-evidence/published-page.js"
    },
    "./web-evidence/testing": {
      "types": "./dist/web-evidence/testing/fake-clock.d.ts",
      "import": "./dist/web-evidence/testing/fake-clock.js",
      "default": "./dist/web-evidence/testing/fake-clock.js"
    },
    "./web-evidence/capture-budget": {
      "types": "./dist/web-evidence/capture-budget.d.ts",
      "import": "./dist/web-evidence/capture-budget.js",
      "default": "./dist/web-evidence/capture-budget.js"
    },
    "./web-evidence/capture-clock": {
      "types": "./dist/web-evidence/capture-clock.d.ts",
      "import": "./dist/web-evidence/capture-clock.js",
      "default": "./dist/web-evidence/capture-clock.js"
    },
    "./domain-dns": {
      "types": "./dist/domain-dns/index.d.ts",
      "import": "./dist/domain-dns/index.js",
      "default": "./dist/domain-dns/index.js"
    },
    "./local-text": {
      "types": "./dist/local-text.d.ts",
      "import": "./dist/local-text.js",
      "default": "./dist/local-text.js"
    },
    "./console-tee": {
      "types": "./dist/console-tee.d.ts",
      "import": "./dist/console-tee.js",
      "default": "./dist/console-tee.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@jini-ai/analytics": "workspace:^",
    "@jini-ai/core": "workspace:^",
    "@vitest/coverage-v8": "^3.2.6",
    "jszip": "^3.10.1",
    "parse5": "7.3.0"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^",
    "js-tokens": "^9.0.1",
    "jszip": "^3.10.1"
  },
  "peerDependencies": {
    "parse5": "7.3.0"
  },
  "peerDependenciesMeta": {
    "parse5": {
      "optional": true
    }
  }
}
