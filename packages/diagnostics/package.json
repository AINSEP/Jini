{
  "name": "@jini-ai/diagnostics",
  "version": "0.5.0",
  "description": "Diagnostics-bundle tooling: JSON/text secret redaction, log-source collection, manifest building, and zip packaging for support exports.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/diagnostics"
  },
  "jini": {
    "domain": "tooling",
    "kind": "diagnostics",
    "entries": {
      ".": "node",
      "./redaction/secrets-only": "universal",
      "./observability": "universal",
      "./observability/node": "node",
      "./web-evidence": "universal",
      "./web-evidence/playwright": "node",
      "./domain-dns": "node"
    },
    "runtime": "node"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./redaction/secrets-only": {
      "types": "./dist/redaction/secrets-only.d.ts",
      "import": "./dist/redaction/secrets-only.js",
      "default": "./dist/redaction/secrets-only.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js",
      "default": "./dist/observability/index.js"
    },
    "./observability/node": {
      "types": "./dist/observability/node.d.ts",
      "import": "./dist/observability/node.js",
      "default": "./dist/observability/node.js"
    },
    "./web-evidence": {
      "types": "./dist/web-evidence/index.d.ts",
      "import": "./dist/web-evidence/index.js",
      "default": "./dist/web-evidence/index.js"
    },
    "./web-evidence/playwright": {
      "types": "./dist/web-evidence/playwright-browser.d.ts",
      "import": "./dist/web-evidence/playwright-browser.js",
      "default": "./dist/web-evidence/playwright-browser.js"
    },
    "./domain-dns": {
      "types": "./dist/domain-dns/index.d.ts",
      "import": "./dist/domain-dns/index.js",
      "default": "./dist/domain-dns/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "@jini-ai/core": "workspace:^",
    "jszip": "^3.10.1"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "jszip": "^3.10.1"
  },
  "peerDependenciesMeta": {
    "jszip": {
      "optional": true
    }
  }
}
