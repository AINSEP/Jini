{
  "name": "@jini-ai/plugin-fly",
  "version": "0.6.17",
  "description": "Independently installable Fly.io server deploy plugin (fly.toml and deploy-workflow generation, deploy operations, FlyV1 credential scheme) in the portable Agent Plugins format.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugin-fly"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./package.json": "universal",
      "./plugin.json": "universal",
      "./fly/*": "universal"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./plugin.json": "./fly/plugin.json",
    "./fly/*": "./fly/*"
  },
  "files": ["fly", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts fly",
    "prepack": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts fly"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
