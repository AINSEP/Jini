{
  "name": "@jini-ai/chat",
  "version": "0.6.16",
  "description": "Jini's chat/artifact frontend, consolidated into one package with two subpaths: framework-free chat vocabulary and pure parsers in `/core`, headless hooks + presentational components + slots in `/react`. Import only the layer you need.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/chat"
  },
  "jini": {
    "domain": "chat",
    "kind": "state",
    "runtime": "universal",
    "entries": {
      ".": "universal",
      "./testing": "universal",
      "./core": "universal",
      "./react": "browser",
      "./react/chat-pane": "browser",
      "./react/styles/reference.css": "browser",
      "./store": "universal",
      "./store/sqlite": "node",
      "./store/pglite": "node",
      "./store/postgres": "node",
      "./store/legacy": "universal",
      "./store/legacy/sqlite": "node",
      "./core/run-events": "universal",
      "./core/ag-ui": "universal",
      "./server/run-finalizer": "universal",
      "./react/embed": "browser",
      "./transports/fetch-sse": "universal",
      "./transports/http": "universal",
      "./transports/ag-ui": "universal",
      "./browser/session-store": "browser",
      "./server/durable-runs": "node",
      "./store/runtime": "node",
      "./vanilla": "browser",
      "./browser/lazy-loader": "browser",
      "./vanilla/style.css": "browser",
      "./browser/frontend-session-bridge": "browser"
    },
    "neutralEntries": [
      "src/store/contracts"
    ],
    "isolation": {
      "entries": {
        "./transports/http": "core",
        "./transports/ag-ui": "core",
        "./browser/frontend-session-bridge": "core"
      }
    },
    "optionalPeers": {
      "better-sqlite3": "opt-in: sqlite storage — SQLite storage could not load better-sqlite3. Install better-sqlite3 to enable this feature, or check its installed version and native binaries.",
      "@electric-sql/pglite": "opt-in: embedded postgresql storage — Embedded PostgreSQL storage could not load @electric-sql/pglite. Install @electric-sql/pglite to enable this feature, or check its installed version and native binaries.",
      "pg": "opt-in: postgresql storage — PostgreSQL storage could not load pg. Install pg to enable this feature, or check its installed version and native binaries.",
      "@ag-ui/core": "opt-in: ag ui protocol adapter; import @jini-ai/chat/core/ag-ui — AG UI protocol adapter could not load @ag-ui/core. Install @ag-ui/core to enable this feature, or check its installed version and native binaries.",
      "@mcp-ui/client": "opt-in: mcp ui renderer; import @jini-ai/chat/react — MCP UI renderer could not load @mcp-ui/client. Install @mcp-ui/client to enable this feature, or check its installed version and native binaries.",
      "@radix-ui/react-checkbox": "opt-in: interactive ui controls; import @jini-ai/chat/react — Interactive UI controls could not load @radix-ui/react-checkbox. Install @radix-ui/react-checkbox to enable this feature, or check its installed version and native binaries.",
      "@radix-ui/react-label": "opt-in: interactive ui controls; import @jini-ai/chat/react — Interactive UI controls could not load @radix-ui/react-label. Install @radix-ui/react-label to enable this feature, or check its installed version and native binaries.",
      "@radix-ui/react-radio-group": "opt-in: interactive ui controls; import @jini-ai/chat/react — Interactive UI controls could not load @radix-ui/react-radio-group. Install @radix-ui/react-radio-group to enable this feature, or check its installed version and native binaries.",
      "@radix-ui/react-select": "opt-in: interactive ui controls; import @jini-ai/chat/react — Interactive UI controls could not load @radix-ui/react-select. Install @radix-ui/react-select to enable this feature, or check its installed version and native binaries.",
      "@radix-ui/react-slot": "opt-in: interactive ui controls — Interactive UI controls could not load @radix-ui/react-slot. Install @radix-ui/react-slot to enable this feature, or check its installed version and native binaries.",
      "@jini-ai/agent-runtime": "opt-in: agent execution adapters; import @jini-ai/chat/react — Agent execution adapters could not load @jini-ai/agent-runtime. Install @jini-ai/agent-runtime to enable this feature, or check its installed version and native binaries.",
      "@jini-ai/protocol": "opt-in: agent protocol adapters; import @jini-ai/chat/server/durable-runs — Agent protocol adapters could not load @jini-ai/protocol. Install @jini-ai/protocol to enable this feature, or check its installed version and native binaries.",
      "@jini-ai/ui": "opt-in: ui integrations; import @jini-ai/chat/react — UI integrations could not load @jini-ai/ui. Install @jini-ai/ui to enable this feature, or check its installed version and native binaries.",
      "react": "opt-in: react chat ui; import @jini-ai/chat/react — React chat UI could not load react. Install react to enable this feature, or check its installed version.",
      "react-dom": "opt-in: react chat ui; import @jini-ai/chat/react — React chat UI could not load react-dom. Install react-dom to enable this feature, or check its installed version."
    }
  },
  "type": "module",
  "sideEffects": [
