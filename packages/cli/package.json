{
  "name": "@jini-ai/cli",
  "version": "0.4.1",
  "description": "CLI transport shell for driving a Jini daemon over HTTP: flag parsing, daemon-URL resolution, local daemon discovery, and a pluggable command registry.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/cli"
  },
  "jini": {
    "domain": "server",
    "kind": "cli",
    "entries": {
      ".": "node",
      "./introspection": "universal"
    },
    "runtime": "node"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./introspection": {
      "types": "./dist/introspection.d.ts",
      "import": "./dist/introspection.js",
      "default": "./dist/introspection.js"
    }
  },
  "bin": {
    "jini": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "commander": "^15.0.0",
    "@jini-ai/core": "workspace:*",
    "@jini-ai/platform": "workspace:*",
    "@jini-ai/sidecar": "workspace:*"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "@jini-ai/platform": "^0.5.1",
    "@jini-ai/sidecar": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@jini-ai/platform": {
      "optional": true
    },
    "@jini-ai/sidecar": {
      "optional": true
    }
  }
}
