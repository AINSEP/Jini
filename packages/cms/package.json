{
  "name": "@jini-ai/cms",
  "version": "0.1.0",
  "description": "Content-model capability for Jini-hosted products: framework-free contracts, ports, and domain services in `/core` and per-domain subpaths; Node-bound persistence adapters in `/server`.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/cms"
  },
  "jini": {
    "domain": "capability",
    "kind": "content-model",
    "runtime": "universal",
    "entries": {
      ".": "universal",
      "./core": "universal",
      "./identity": "node",
      "./server": "node",
      "./identity/hasher": "node",
      "./navigation": "universal",
      "./media": "universal",
      "./settings": "universal",
      "./workspace": "universal",
      "./entries": "universal",
      "./content-types": "universal",
      "./taxonomy": "universal",
      "./widgets": "universal",
      "./presentation": "universal"
    }
  },
  "type": "module",
  "sideEffects": [
    "./dist/identity/permissions.js"
  ],
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js",
      "default": "./dist/identity/index.js"
    },
    "./identity/hasher": {
      "types": "./dist/identity/hasher.d.ts",
      "import": "./dist/identity/hasher.js",
      "default": "./dist/identity/hasher.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js",
      "default": "./dist/navigation/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js",
      "default": "./dist/media/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js",
      "default": "./dist/settings/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js",
      "default": "./dist/workspace/index.js"
    },
    "./entries": {
      "types": "./dist/entries/index.d.ts",
      "import": "./dist/entries/index.js",
      "default": "./dist/entries/index.js"
    },
    "./content-types": {
      "types": "./dist/content-types/index.d.ts",
      "import": "./dist/content-types/index.js",
      "default": "./dist/content-types/index.js"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy/index.d.ts",
      "import": "./dist/taxonomy/index.js",
      "default": "./dist/taxonomy/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "import": "./dist/widgets/index.js",
      "default": "./dist/widgets/index.js"
    },
    "./presentation": {
      "types": "./dist/presentation/index.d.ts",
      "import": "./dist/presentation/index.js",
      "default": "./dist/presentation/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:packaging": "node scripts/check-packaging.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "argon2": "^0.44.0",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:*"
  },
  "peerDependencies": {
    "argon2": "^0.44.0",
    "sharp": "^0.35.3"
  },
  "peerDependenciesMeta": {
    "argon2": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  }
}
