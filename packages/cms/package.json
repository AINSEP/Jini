      "./widgets/html": "node",
      "./widgets/resolvers": "universal",
      "./widgets/sql": "node",
      "./consent": "universal",
      "./consent/html": "node",
      "./consent/express": "node",
      "./consent/node": "node",
      "./listing": "universal"
    },
    "isolation": {
      "domains": {
        "content-types": [
          "src/content-types"
        ],
        "core": [
          "src/core"
        ],
        "entries": [
          "src/entries"
        ],
        "media": [
          "src/media"
        ],
        "navigation": [
          "src/navigation"
        ],
        "routing": [
