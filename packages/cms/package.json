        ],
        "trash": [
          "src/trash"
        ],
        "workspace": [
          "src/workspace"
        ],
        "forms": [
          "src/forms"
        ],
        "comments": [
          "src/comments"
        ],
        "redirects": [
          "src/redirects"
        ],
        "seo": [
          "src/seo"
        ],
        "widgets": [
          "src/widgets"
        ],
        "consent": [
          "src/consent"
        ],
        "listing": [
          "src/listing"
        ]
      },
      "forbidden": {
        "universal": [
          "node:",
          "express",
          "kysely",
          "parse5",
          "react"
        ],
        "browser": [
          "node:",
          "express",
          "kysely",
          "parse5",
          "react"
        ]
      }
    }
