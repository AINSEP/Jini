{
  "name": "@jini-ai/cms",
  "version": "0.5.1",
  "description": "Content-model capability for Jini-hosted products: framework-free contracts, ports, and domain services in `/core` and per-domain subpaths; Node-bound adapters in domain-specific subpaths.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/cms"
  },
  "jini": {
    "domain": "capability",
    "kind": "content-model",
    "runtime": "universal",
    "entries": {
      ".": "universal",
      "./core": "universal",
      "./navigation": "universal",
      "./media": "node",
      "./settings": "universal",
      "./workspace": "universal",
      "./entries": "universal",
      "./content-types": "universal",
      "./taxonomy": "universal",
      "./presentation": "universal",
      "./media/import": "universal",
      "./core/tools": "universal",
      "./http/settings": "node",
      "./trash": "universal"
    }
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js",
      "default": "./dist/navigation/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js",
      "default": "./dist/media/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js",
      "default": "./dist/settings/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js",
      "default": "./dist/workspace/index.js"
    },
    "./entries": {
      "types": "./dist/entries/index.d.ts",
      "import": "./dist/entries/index.js",
      "default": "./dist/entries/index.js"
    },
    "./content-types": {
      "types": "./dist/content-types/index.d.ts",
      "import": "./dist/content-types/index.js",
      "default": "./dist/content-types/index.js"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy/index.d.ts",
      "import": "./dist/taxonomy/index.js",
      "default": "./dist/taxonomy/index.js"
    },
    "./presentation": {
      "types": "./dist/presentation/index.d.ts",
      "import": "./dist/presentation/index.js",
      "default": "./dist/presentation/index.js"
    },
    "./core/tools": {
      "types": "./dist/core/tools/index.d.ts",
      "import": "./dist/core/tools/index.js",
      "default": "./dist/core/tools/index.js"
    },
    "./media/import": {
      "types": "./dist/media/import/index.d.ts",
      "import": "./dist/media/import/index.js",
      "default": "./dist/media/import/index.js"
    },
    "./http/settings": {
      "types": "./dist/http/settings/index.d.ts",
      "import": "./dist/http/settings/index.js",
      "default": "./dist/http/settings/index.js"
    },
    "./trash": {
      "types": "./dist/trash/index.d.ts",
      "import": "./dist/trash/index.js",
      "default": "./dist/trash/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!forms/**",
    "!dist/identity/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:packaging": "node scripts/check-packaging.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "sharp": "^0.35.3",
    "@jini-ai/http-kit": "workspace:*",
    "express": "^4.21.0",
    "@types/express": "^4.17.21",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "sharp": "^0.35.3",
    "express": "^4.21.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  }
}
