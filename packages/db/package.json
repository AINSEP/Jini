    },
    "./verified-origin": {
      "types": "./dist/verified-origin/index.d.ts",
      "import": "./dist/verified-origin/index.js",
      "default": "./dist/verified-origin/index.js"
    },
    "./data-modules": {
      "types": "./dist/data-modules/index.d.ts",
      "import": "./dist/data-modules/index.js",
      "default": "./dist/data-modules/index.js"
    },
    "./watermark/kernel": {
      "types": "./dist/watermark/kernel.d.ts",
      "import": "./dist/watermark/kernel.js",
      "default": "./dist/watermark/kernel.js"
    },
    "./site/repo.memory": {
      "types": "./dist/site/repo.memory.d.ts",
      "import": "./dist/site/repo.memory.js",
      "default": "./dist/site/repo.memory.js"
    },
    "./transfer/confirmation-ui": {
      "types": "./dist/transfer/confirmation-ui.d.ts",
      "import": "./dist/transfer/confirmation-ui.js",
      "default": "./dist/transfer/confirmation-ui.js"
    },
    "./transfer/destination-store": {
      "types": "./dist/transfer/destination-store.d.ts",
      "import": "./dist/transfer/destination-store.js",
      "default": "./dist/transfer/destination-store.js"
    },
    "./react/recovery/Recovery": {
      "types": "./dist/react/recovery/Recovery.d.ts",
      "import": "./dist/react/recovery/Recovery.js",
      "default": "./dist/react/recovery/Recovery.js"
    },
    "./recovery/tool-registrations": {
      "types": "./dist/recovery/tool-registrations.d.ts",
      "import": "./dist/recovery/tool-registrations.js",
      "default": "./dist/recovery/tool-registrations.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.ts"
      ],
      "sqlite": [
        "./dist/sqlite/index.d.ts"
      ],
      "pglite": [
        "./dist/pglite/index.d.ts"
      ],
      "postgres": [
        "./dist/postgres/index.d.ts"
      ],
      "kernel": [
        "./dist/kernel/index.d.ts"
      ],
      "kernel/sqlite": [
        "./dist/kernel/sqlite/index.d.ts"
      ],
      "kernel/pglite": [
        "./dist/kernel/pglite/index.d.ts"
      ],
      "kernel/postgres": [
        "./dist/kernel/postgres/index.d.ts"
      ],
      "migrate": [
        "./dist/migrate/index.d.ts"
      ],
      "testing/pg-fixture": [
        "./dist/pg-fixture.d.ts"
      ],
      "package.json": [
