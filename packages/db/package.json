{
  "name": "@jini-ai/db",
  "version": "0.7.3-next.2",
  "description": "Database ports, connection helpers, ownership, isolated Kysely kernels and migrations. All peers are optional; drivers are injected.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/db"
  },
  "jini": {
    "domain": "server",
    "kind": "persistence-adapter",
    "runtime": "node",
    "neutralEntries": [
      "src/core"
    ],
    "isolation": {
      "entries": {
        "./tools": "transfer",
        "./react/recovery/Recovery": "react"
      },
      "shared": [
        "src/shared/ddl.adapter.ts",
        "src/kernel/dialect.ts",
        "src/kernel/idle-turn.ts",
        "src/kernel/index.ts",
        "src/kernel/kernel-core.ts",
        "src/kernel/ops.ts",
        "src/kernel/owned-transaction.ts",
        "src/kernel/port.ts",
        "src/kernel/postgres-lock.ts",
        "src/kernel/schema-scope.ts",
        "src/kernel/session-lock.ts",
        "src/kernel/schema-shape.ts",
        "src/kernel/store-copy.ts",
        "src/kernel/turn-lock.ts",
        "src/kernel/typegen.ts",
        "src/sqlite/backup-policy.ts",
        "src/sqlite/checked-state.ts"
      ]
    },
    "optionalPeers": {
      "better-sqlite3": "opt-in: sqlite storage \u2014 SQLite storage could not load better-sqlite3. Install better-sqlite3 to enable this feature, or check its installed version and native binaries.",
      "@electric-sql/pglite": "opt-in: embedded postgresql storage \u2014 Embedded PostgreSQL storage could not load @electric-sql/pglite. Install @electric-sql/pglite to enable this feature, or check its installed version and native binaries.",
      "pg": "opt-in: postgresql storage \u2014 PostgreSQL storage could not load pg. Install pg to enable this feature, or check its installed version and native binaries.",
      "react": "opt-in: react browser bindings; import @jini-ai/db/react/recovery/Recovery \u2014 React browser bindings could not load react. Install react to enable this feature, or check its installed version.",
      "react-dom": "opt-in: react browser bindings; import @jini-ai/db/react/recovery/Recovery \u2014 React browser bindings could not load react-dom. Install react-dom to enable this feature, or check its installed version."
    },
    "entries": {
      "./core": "node",
      "./sqlite": "node",
      "./pglite": "node",
      "./postgres": "node",
      "./kernel": "node",
      "./kernel/sqlite": "node",
      "./kernel/pglite": "node",
      "./kernel/postgres": "node",
      "./migrate": "node",
      "./testing/pg-fixture": "node",
      "./package.json": "node",
      "./transfer": "node",
      "./tools": "node",
      "./kernel/store-copy": "node",
      "./recovery/*": "node",
      "./recovery": "node",
      "./owner-store": "node",
      "./secrets-vault": "node",
      "./settings": "node",
      "./events": "node",
      "./gated-mutations": "node",
      "./verified-origin": "node",
      "./data-modules": "node",
      "./watermark/kernel": "node",
      "./react/recovery/Recovery": "browser",
      "./site/repo.memory": "node",
      "./transfer/confirmation-ui": "node",
      "./transfer/destination-store": "node",
      "./recovery/tool-registrations": "universal"
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js",
      "default": "./dist/sqlite/index.js"
    },
    "./pglite": {
      "types": "./dist/pglite/index.d.ts",
      "import": "./dist/pglite/index.js",
      "default": "./dist/pglite/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js",
      "default": "./dist/postgres/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js",
      "default": "./dist/kernel/index.js"
    },
    "./kernel/sqlite": {
      "types": "./dist/kernel/sqlite/index.d.ts",
      "import": "./dist/kernel/sqlite/index.js",
      "default": "./dist/kernel/sqlite/index.js"
