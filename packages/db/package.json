      "default": "./dist/pg-fixture.js"
    },
    "./package.json": "./package.json",
    "./transfer": {
      "types": "./dist/transfer/index.d.ts",
      "import": "./dist/transfer/index.js",
      "default": "./dist/transfer/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "default": "./dist/tools/index.js"
    },
    "./kernel/store-copy": {
      "types": "./dist/kernel/store-copy.d.ts",
      "import": "./dist/kernel/store-copy.js",
      "default": "./dist/kernel/store-copy.js"
    },
    "./recovery/*": {
      "types": "./dist/recovery/*.d.ts",
      "import": "./dist/recovery/*.js",
      "default": "./dist/recovery/*.js"
    },
    "./recovery": {
      "types": "./dist/recovery/index.d.ts",
      "import": "./dist/recovery/index.js",
      "default": "./dist/recovery/index.js"
    },
    "./owner-store": {
      "types": "./dist/owner-store/index.d.ts",
      "import": "./dist/owner-store/index.js",
      "default": "./dist/owner-store/index.js"
    },
    "./secrets-vault": {
      "types": "./dist/secrets-vault/index.d.ts",
      "import": "./dist/secrets-vault/index.js",
      "default": "./dist/secrets-vault/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js",
      "default": "./dist/settings/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js",
      "default": "./dist/events/index.js"
    },
    "./gated-mutations": {
      "types": "./dist/gated-mutations/index.d.ts",
