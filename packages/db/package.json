      ],
      "data-modules": [
        "./dist/data-modules/index.d.ts"
      ],
      "watermark/kernel": [
        "./dist/watermark/kernel.d.ts"
      ],
      "react/recovery/Recovery": [
        "./dist/react/recovery/Recovery.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "LICENSE.pglite-socket",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/__tests__/**",
    "!dist/**/testing/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.react.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.react.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:postgres": "vitest run --config vitest.postgres.config.ts"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^",
    "kysely": "^0.29.6"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.0",
    "@electric-sql/pglite": "0.5.8",
    "pg": "^8.23.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/better-sqlite3": "7.6.13",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "^3.2.6",
    "better-sqlite3": "13.0.3",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "@jini-ai/core": "workspace:*",
    "@jini-ai/platform": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
