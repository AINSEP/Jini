{
  "name": "@jini-ai/http-kit",
  "version": "0.4.0",
  "description": "Generic Express transport primitives, request parsing, response serialization, origin guards and route-pack mounting.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/http-kit"
  },
  "jini": {
    "domain": "server",
    "kind": "transport",
    "entries": {
      ".": "node",
      "./rate-limit": "node",
      "./middleware": "node",
      "./verified-origin": "universal",
      "./observability": "node"
    },
    "runtime": "node"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit.d.ts",
      "import": "./dist/rate-limit.js",
      "default": "./dist/rate-limit.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    },
    "./verified-origin": {
      "types": "./dist/verified-origin.d.ts",
      "import": "./dist/verified-origin.js",
      "default": "./dist/verified-origin.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js",
      "default": "./dist/observability.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@vitest/coverage-v8": "^2.1.9",
    "@jini-ai/core": "workspace:*",
    "@jini-ai/platform": "workspace:*",
    "@jini-ai/protocol": "workspace:*",
    "express": "^4.21.0"
  },
  "dependencies": {
    "@jini-ai/protocol": "workspace:^",
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {
    "@jini-ai/platform": "^0.5.1",
    "express": "^4.21.0"
  },
  "peerDependenciesMeta": {
    "@jini-ai/platform": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  }
}
