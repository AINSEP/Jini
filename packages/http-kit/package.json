{
  "name": "@jini-ai/http-kit",
  "version": "0.2.1",
  "description": "Composable Express route packs and JSON-route transport for a @jini-ai/core daemon composition: request parsing, response serialization, same-origin guard, and a route-pack registrar.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/http-kit"
  },
  "jini": {
    "domain": "server",
    "kind": "transport",
    "runtime": "node"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@jini-ai/agent-runtime": "workspace:*",
    "@jini-ai/core": "workspace:*",
    "@jini-ai/daemon": "workspace:*",
    "@jini-ai/platform": "workspace:*",
    "@jini-ai/protocol": "workspace:*",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@jini-ai/chat-core": "workspace:*",
    "@types/express": "^4.17.21",
    "@vitest/coverage-v8": "^2.1.9"
  }
}
