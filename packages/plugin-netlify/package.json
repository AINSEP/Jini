{
  "name": "@jini-ai/plugin-netlify",
  "version": "0.6.17",
  "description": "Independently installable Netlify static-site publishing in the portable Agent Plugins format.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/plugin-netlify"
  },
  "jini": {
    "domain": "tooling",
    "kind": "plugin-packaging",
    "runtime": "universal",
    "entries": {
      "./package.json": "universal",
      "./plugin.json": "universal",
      "./netlify/*": "universal"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./plugin.json": "./netlify/plugin.json",
    "./netlify/*": "./netlify/*"
  },
  "files": ["netlify", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts netlify",
    "prepack": "node --import tsx ../../scripts/assemble-agent-plugin-package.ts netlify"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
