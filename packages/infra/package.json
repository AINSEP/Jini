{
  "name": "@jini-ai/infra",
  "version": "0.5.0",
  "description": "Deprecated compatibility re-exports of @jini-ai/db/core and @jini-ai/db/sqlite. Import those directly.",
  "deprecated": "Compatibility shim: use @jini-ai/db/core and @jini-ai/db/sqlite directly.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/infra"
  },
  "jini": {
    "domain": "server",
    "kind": "persistence-adapter",
    "runtime": "node",
    "neutralEntries": [
      "src/db/core"
    ]
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./events/outbox": {
      "types": "./dist/events/outbox/index.d.ts",
      "import": "./dist/events/outbox/index.js",
      "default": "./dist/events/outbox/index.js"
    },
    "./db/core": {
      "import": {
        "types": "./dist/db/core/index.d.ts",
        "default": "./dist/db/core/index.js"
      }
    },
    "./db/sqlite": {
      "import": {
        "types": "./dist/db/sqlite/index.d.ts",
        "default": "./dist/db/sqlite/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "events/outbox": [
        "./dist/events/outbox/index.d.ts"
      ],
      "db/core": [
        "./dist/db/core/index.d.ts"
      ],
      "db/sqlite": [
        "./dist/db/sqlite/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "@jini-ai/core": "workspace:*"
  },
  "dependencies": {
    "@jini-ai/db": "workspace:*",
    "@jini-ai/core": "workspace:^"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {}
}
