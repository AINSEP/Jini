{
  "name": "@jini-ai/infra",
  "version": "0.7.3-next.2",
  "description": "Host-composed event outbox: fenced enqueue, drain and retry policy.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/infra"
  },
  "jini": {
    "domain": "server",
    "kind": "persistence-adapter",
    "runtime": "node",
    "entries": {
      "./events/outbox-trace-parent": "node"
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./events/outbox": {
      "types": "./dist/events/outbox/index.d.ts",
      "import": "./dist/events/outbox/index.js",
      "default": "./dist/events/outbox/index.js"
    },
    "./events/memory-bus": {
      "types": "./dist/events/memory-bus.d.ts",
      "import": "./dist/events/memory-bus.js",
      "default": "./dist/events/memory-bus.js"
    },
    "./events/domain-outbox": {
      "types": "./dist/events/domain-outbox.d.ts",
      "import": "./dist/events/domain-outbox.js",
      "default": "./dist/events/domain-outbox.js"
    },
    "./events/outbox-trace-parent": {
      "types": "./dist/events/outbox-trace-parent.d.ts",
      "import": "./dist/events/outbox-trace-parent.js",
      "default": "./dist/events/outbox-trace-parent.js"
    }
  },
  "typesVersions": {
    "*": {
      "events/outbox": [
        "./dist/events/outbox/index.d.ts"
      ],
      "events/memory-bus": [
        "./dist/events/memory-bus.d.ts"
      ],
      "events/domain-outbox": [
        "./dist/events/domain-outbox.d.ts"
      ],
      "events/outbox-trace-parent": [
        "./dist/events/outbox-trace-parent.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "@jini-ai/core": "workspace:*"
  },
  "dependencies": {
    "@jini-ai/core": "workspace:^"
  }
}
