{
  "name": "@jini-ai/infra",
  "version": "0.5.0",
  "description": "Deprecated: a re-export of `@jini-ai/db` (`./core`, `./sqlite`). Import those directly. Removed after one release.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINSEP/Jini.git",
    "directory": "packages/infra"
  },
  "jini": {
    "domain": "server",
    "kind": "persistence-adapter",
    "runtime": "node",
    "neutralEntries": [
      "src/db/core"
    ]
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./db/core": {
      "import": {
        "types": "./dist/db/core/index.d.ts",
        "default": "./dist/db/core/index.js"
      }
    },
    "./db/sqlite": {
      "import": {
        "types": "./dist/db/sqlite/index.d.ts",
        "default": "./dist/db/sqlite/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "db/core": [
        "./dist/db/core/index.d.ts"
      ],
      "db/sqlite": [
        "./dist/db/sqlite/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9"
  },
  "dependencies": {
    "@jini-ai/db": "workspace:*",
    "@jini-ai/core": "workspace:*"
  }
}
