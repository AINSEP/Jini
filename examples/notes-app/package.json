{
  "name": "@jini-example/notes-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A small notes app built by wiring @jini-ai/* packages behind a plain Node http server.",
  "scripts": {
    "start": "node src/main.ts",
    "smoke": "node scripts/smoke.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jini-ai/cms": "workspace:*",
    "@jini-ai/core": "workspace:*",
    "@jini-ai/db": "workspace:*",
    "@jini-ai/http-kit": "workspace:*",
    "better-sqlite3": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
