@@ -0,0 +1,66 @@
+import { createContext, createElement } from 'react';
+import { afterEach, describe, expect, it } from 'vitest';
+import { cleanup, render, renderHook, screen } from '@testing-library/react';
+import { AdminConfigError } from '@jini-ai/core/admin-runtime';
+import { adminPort, defineAdminModule } from '@jini-ai/core/contracts/admin-module';
+import type { ScopedPorts } from '@jini-ai/core/contracts/admin-module';
+import { bindReact } from '../bind-react.js';
+
+afterEach(cleanup);
+
+const clock = adminPort<{ now(): string }>({ id: 'test.clock' });
+const module = defineAdminModule({
+  id: 'test.clock-module',
+  requires: { clock },
+  pages: { home: { path: '/home', label: 'Home', tabs: { main: { label: 'Main' } } } },
+});
+const views = {
+  home: {
+    page: async () => ({ default: () => createElement('p', null, 'page loaded') }),
+    tabs: { main: async () => ({ default: () => createElement('p', null, 'tab loaded') }) },
+  },
+};
+
+describe('bindReact', () => {
+  it('returns the module, one lazy page and one lazy component per tab', () => {
+    const react = bindReact({ module, views });
+    expect(react.module).toBe(module);
+    expect(Object.keys(react.pages)).toEqual(['home']);
+    expect(Object.keys(react.pages.home.tabs)).toEqual(['main']);
+    expect(react.pages.home.Page).toBeDefined();
+  });
+
+  it('serves the scoped ports held by the context it was bound to', () => {
+    const context = createContext<ScopedPorts<typeof module> | null>(null);
+    const react = bindReact({ module, views }, { context });
+    const ports = { clock: { now: () => 'noon' } };
+    const { result } = renderHook(() => react.usePorts(), {
+      wrapper: ({ children }) => createElement(context.Provider, { value: ports, children }),
+    });
+    expect(result.current).toBe(ports);
+  });
+
+  it('refuses to hand out ports outside its Provider, naming the module', () => {
+    const react = bindReact({ module, views });
+    expect(() => renderHook(() => react.usePorts())).toThrow(AdminConfigError);
+    expect(() => renderHook(() => react.usePorts())).toThrow(/React scope unavailable: test\.clock-module/);
+  });
+
+  it("keeps one binding's ports private: a sibling never reads this module's context", () => {
+    const own = createContext<ScopedPorts<typeof module> | null>(null);
+    const b = bindReact({ module, views });
+    expect(() =>
+      renderHook(() => b.usePorts(), {
+        wrapper: ({ children }) => createElement(own.Provider, { value: { clock: { now: () => 'noon' } }, children }),
+      }),
+    ).toThrow(AdminConfigError);
+  });
+
+  it('renders a lazy page only when it is used', async () => {
+    const react = bindReact({ module, views });
+    render(createElement(react.pages.home.Page, {
+      tabs: {}, description: { id: 'home', path: '/home', label: 'Home', visible: true, agentReachable: false, permissions: [], grants: [], tabs: [] },
+    }));
+    expect(await screen.findByText('page loaded')).toBeTruthy();
+  });
+});
diff --git a/packages/ui-kit/src/react/admin-module/__tests__/use-controller.test.ts b/packages/ui-kit/src/react/admin-module/__tests__/use-controller.test.ts
new file mode 100644
index 00000000..4ea523d2
--- /dev/null
+++ b/packages/ui-kit/src/react/admin-module/__tests__/use-controller.test.ts
@@ -0,0 +1,61 @@
+import { StrictMode, createElement } from 'react';
+import { afterEach, describe, expect, it } from 'vitest';
+import { act, cleanup, renderHook } from '@testing-library/react';
+import { createControllerStore } from '@jini-ai/core/admin-runtime';
+import { useController } from '../use-controller.js';
+
+afterEach(cleanup);
+
+const make = () => createControllerStore({ initial: { count: 0 } });
+
+describe('useController', () => {
+  it('has no controller during render and owns a fresh one after commit', () => {
+    const created: unknown[] = [];
+    const { result } = renderHook(() =>
+      useController({ create: () => { const c = make(); created.push(c); return c; }, dependencies: [] }),
+    );
+    expect(created).toHaveLength(1);
+    expect(result.current.controller).toBe(created[0]);
+    expect(result.current.snapshot).toEqual({ count: 0 });
+  });
+
+  it('re-renders with the new snapshot after the controller writes', () => {
+    const { result } = renderHook(() => useController({ create: make, dependencies: [] }));
+    act(() => result.current.controller?.set({ patch: { count: 3 } }));
+    expect(result.current.snapshot).toEqual({ count: 3 });
+  });
+
+  it('hands the controller to start once, after it is created', () => {
+    const started: unknown[] = [];
+    const { result } = renderHook(() =>
+      useController({ create: make, dependencies: [] }, { start: ({ controller }) => started.push(controller) }),
+    );
+    expect(started).toEqual([result.current.controller]);
+  });
+
+  it('disposes the controller on unmount, aborting its signal', () => {
+    const { result, unmount } = renderHook(() => useController({ create: make, dependencies: [] }));
+    const controller = result.current.controller!;
+    expect(controller.signal.aborted).toBe(false);
+    unmount();
+    expect(controller.signal.aborted).toBe(true);
+  });
+
+  it('replaces and disposes the controller when the dependencies change', () => {
+    const { result, rerender } = renderHook(({ id }) => useController({ create: make, dependencies: [id] }), {
+      initialProps: { id: 'a' },
+    });
+    const first = result.current.controller!;
+    rerender({ id: 'b' });
+    expect(first.signal.aborted).toBe(true);
+    expect(result.current.controller).not.toBe(first);
+    expect(result.current.controller!.signal.aborted).toBe(false);
+  });
+
+  it("StrictMode's cleanup/replay never leaves a disposed controller as the current one", () => {
+    const { result } = renderHook(() => useController({ create: make, dependencies: [] }), {
+      wrapper: ({ children }) => createElement(StrictMode, null, children),
+    });
+    expect(result.current.controller!.signal.aborted).toBe(false);
+  });
+});
