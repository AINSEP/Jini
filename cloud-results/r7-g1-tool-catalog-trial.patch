+
+/** Mounts a route list at this position, as a host does, and records each route with its gate names as its layers. */
+function mountRouteList({ app, routes }: { app: Express; routes: readonly ServerRoute[] }): void {
+  const dispatcher = createNodeDispatcher();
+  for (const route of routes) dispatcher.server.route(route);
+  const recorder = app as unknown as { use(path: string, ...layers: unknown[]): void };
+  void recorder;
+  app.use((req, res, next) => { void dispatcher.handle({ incoming: req, out: res }, { next, parsedBody: (req as { body?: unknown }).body }); });
+  listed.push(...describeRoutes({ routes }));
+}
+const listed: { method: string; path: string; gates: readonly string[] }[] = [];
