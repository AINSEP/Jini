node_modules/
dist/
dist-tarballs/
dist-mcpui-view/
*.tsbuildinfo
.tmp/
coverage/
*.log
.DS_Store
.env
.env.local

# npm publish auth token (see scripts/publish-all.ts) — never committed, never part of any
# package's published `files`.
.npmrc

# Local Jini daemon state and browser automation snapshots
.jini/
.playwright-mcp/

# Written into a run's cwd at spawn by @jini/daemon's mcpJsonInjection (the jini-mcp bridge entry).
# Per-run generated config, not project source — see packages/daemon/src/agent-executor.ts.
.mcp.json

# Claude Code harness-local session state (worktrees, one-time init flags).
# Contents are excluded rather than the directory itself: git cannot re-include a path whose
# parent directory is excluded, and `.claude/agents/` below must stay trackable.
.claude/*
# Agent definitions and skills are shared project config, not session state — AGENTS.md names
# `sidekick` as a startup step, so these have to survive a fresh clone.
!.claude/agents/
!.claude/skills/

# The foundry is Jini's local workshop — the Open Design reference dumps and the project-runner
# control plane. Deliberately untracked: 1404 of its 1541 files were vendored copies of
# third-party source (od-web-src.orig/, components-original/, i18n/locales/) that are not worth
# carrying in the repo. Everything ever tracked here stays in git history up to 96f0a5c8, the
# commit that untracked it.
# NOTE: the design history that used to live at foundry/docs/jini-port/ is NOT covered by this
# rule any more. It moved to ADS-memory/reports/jini-port/ on 2026-08-05 and is tracked, because
# AGENTS.md names START-HERE.md and extraction-plan.md as the locked architecture authority and
# a fresh clone must be able to read them.
/foundry/

# heavy local graph indexes are never committed (see extraction-plan §H)
**/graphify-out/
**/.codegraph/
**/.code-review-graph/
.codebase-memory/
# understand-anything: the graph itself IS committed (AGENTS.md names it as one of the three
# indexes to query before `rg`, so it has to survive a fresh clone). It is cheap despite the raw
# byte count — both JSON files are pretty-printed, so they gzip ~6x and delta well between
# re-indexes. Only the run scratch is excluded.
.understand-anything/tmp/
.understand-anything/intermediate/

# Raw peer-agent transcripts from swarm runs. Only the curated CTX-*.md write-ups are retained;
# the raw jsonl/stderr dumps they were distilled from are scratch.
ADS-memory/reports/swarm-consensus/context/peer-*
ADS-memory/tmp/

# One-off scratch harnesses (hardcoded absolute paths, not runnable on another machine)
examples/*/scratch-*.ts
