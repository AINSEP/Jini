{
  "name": "jini",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "~24",
    "pnpm": ">=10.33.2 <11"
  },
  "scripts": {
    "test:scripts": "vitest run scripts/__tests__ && pnpm run test:scripts:node",
    "test:scripts:node": "node --import tsx --test --test-concurrency=1 scripts/__tests__/check-hardwiring.test.ts scripts/__tests__/integration/infra-retirement.integration.test.ts",
    "guard": "node --import tsx ./scripts/guard.ts",
    "guard:drift": "tsx ./scripts/check-guard-drift.ts",
    "playground": "tsx ./scripts/start-playground.ts",
    "playground:web": "tsx ./scripts/start-playground.ts --web-only",
    "playground:desktop": "pnpm --filter @jini-app/reference-desktop run build && pnpm --filter @jini-app/reference-desktop run dev",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "changeset": "changeset",
    "complexity": "eslint --no-error-on-unmatched-pattern .",
    "complexity:strict": "eslint --no-error-on-unmatched-pattern --no-inline-config --ignore-pattern '**/{__tests__,__measurements__,__mocks__,fixtures,test,tests,vendor,.build}/**' --ignore-pattern '**/*.{test,spec,typecheck}.*' --ignore-pattern '**/*.d.{ts,mts,cts}' --rule '{\"complexity\":[\"error\",10],\"sonarjs/cognitive-complexity\":[\"error\",10]}' \"packages/*/src/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\" \"packages/cms/forms/src/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "quality:knip": "knip --config knip.json --no-exit-code",
    "quality:depcruise": "bash scripts/quality-depcruise.sh",
    "quality:secrets": "bash scripts/quality-secrets.sh",
    "quality:semgrep": "python3 scripts/quality-semgrep.py",
    "quality:semgrep:test": "python3 scripts/quality-semgrep.py --test",
    "quality:properties": "pnpm -r --no-bail --filter @jini-ai/platform --filter @jini-ai/chat --filter @jini-ai/oauth --filter @jini-ai/cms run test:properties",
    "quality:sonar": "eslint --config development/quality/eslint.sonar.config.mjs --format ./development/quality/sonar-formatter.mjs --no-error-on-unmatched-pattern packages"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.8.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0",
    "knip": "5.61.3",
    "dependency-cruiser": "18.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "node-pty"
    ]
  }
}
